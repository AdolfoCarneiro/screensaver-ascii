def texto_grade(txt, esc=1):
    """Texto na fonte 5x5, como grade de pixels (listas de bool)."""
    linhas = [[] for _ in range(5)]
    for k, c in enumerate(txt.upper()):
        g = FONTE.get(c, FONTE[" "])
        for r in range(5):
            if k:
                linhas[r].append(False)
            linhas[r].extend(p == "#" for p in g[r])
    out = []
    for r in linhas:
        linha = [p for p in r for _ in range(esc)]
        out.extend([linha] * esc)
    return out


def meio_blocos(grade):
    linhas = []
    for y in range(0, len(grade), 2):
        a = grade[y]
        b = grade[y + 1] if y + 1 < len(grade) else [False] * len(a)
        linhas.append("".join("█" if p and q else "▀" if p else "▄" if q else " " for p, q in zip(a, b)))
    return linhas


def carregar_arte(txt):
    linhas = [l.replace(" ", "") for l in txt.strip("\n").split("\n")]
    w = max(len(l) for l in linhas)
    return [l.ljust(w, ".") for l in linhas]


def suave(p):
    p = clamp(p)
    return p * p * (3 - 2 * p)


# ---------------------------------------------------------------- cenas

class Cena:
    paleta_fixa = None
    paletas = None
    combinavel = True
    duracao = DURACAO
    peso = 1.0

    def __init__(self, paleta):
        nome = self.paleta_fixa or (random.choice(self.paletas) if self.paletas else paleta)
        self.pal = PALETAS[nome]

    def resize(self, w, h):
        self.w, self.h, self.n = w, h, w * h
        self.vazio = [" "] * self.n
        self.cx, self.cy = w / 2, h / 2
        self.iniciar()

    def iniciar(self):
        pass

    def esperar(self, s):
        fim = self.t + s
        while self.t < fim:
            yield


class Matrix(Cena):
    """Chuva digital: colunas crescem de cima pra baixo e somem pela cauda."""
    paleta_fixa = "verde"
    CH = list("2598Z*):.\"=+-¦|_") + list("ｦｱｳｴｵｶｷｹｺｻｼｽｾｿﾀﾂﾃﾅﾆﾇﾈﾊﾋﾎﾏﾐﾑﾒﾓﾔﾕﾗﾘﾜ")
    PONTA = 0xDBFFDB
    TONS = [(int(0x92 + (0x18 - 0x92) * k / 7) << 16) | (int(0xBE + (0x53 - 0xBE) * k / 7) << 8)
            | int(0x92 + (0x18 - 0x92) * k / 7) for k in range(8)]
    ESCUROS = [((int((c >> 16) * 0.65)) << 16) | (int(((c >> 8) & 255) * 0.65) << 8) | int((c & 255) * 0.65)
               for c in TONS[-3:]]

    def iniciar(self):
        self.revela = (random.uniform(3, 5) if OVOS else random.uniform(6, 15)) if OVOS or random.random() < 0.35 else None
        self.forma = []
        if self.revela:
            alt = self.h * 0.86
            y0 = (self.h - alt) / 2
            larg = 76 * alt / 92 * ASPECTO
            x0 = (self.w - larg) / 2
            for y in range(self.h):
                for x in range(self.w):
                    if rola_regiao((x + 0.5 - x0) / larg * 76, (y + 0.5 - y0) / alt * 92):
                        self.forma.append(y * self.w + x)
        self.sym = [" "] * self.n
        self.cor = [0] * self.n
        self.colunas = []
        self.ocupadas = set()
        self.acc = 0.0
        for _ in range(int(self.w * 0.5)):
            c = self.nova_coluna()
            if c:
                passos = random.randrange(self.h + c["tam"])
                for _ in range(passos):
                    self.passo(c)

    def nova_coluna(self):
        livres = [x for x in range(self.w) if x not in self.ocupadas]
        if not livres:
            return None
        x = random.choice(livres)
        self.ocupadas.add(x)
        c = {"x": x, "cabeca": 0, "topo": 0, "tam": random.randint(max(1, self.h // 10), self.h),
             "vel": random.uniform(5, 28), "acc": 0.0, "segura": 0}
        if c["tam"] == self.h:
            c["segura"] = random.randint(20, 45)
        self.colunas.append(c)
        return c

    def apagar_topo(self, c):
        w = self.w
        self.sym[c["topo"] * w + c["x"]] = " "
        c["topo"] += 1
        if c["cabeca"] - c["topo"] > 1:
            self.cor[c["topo"] * w + c["x"]] = random.choice(self.ESCUROS)

    def passo(self, c):
        w, h, x = self.w, self.h, c["x"]
        if c["cabeca"] < h:
            i = c["cabeca"] * w + x
            self.sym[i] = random.choice(self.CH)
            self.cor[i] = self.PONTA
            if c["cabeca"] > c["topo"]:
                self.cor[i - w] = random.choice(self.TONS)
            c["cabeca"] += 1
        elif c["topo"] < c["cabeca"]:
            ult = (c["cabeca"] - 1) * w + x
            if self.cor[ult] == self.PONTA:
                self.cor[ult] = random.choice(self.TONS)
            if c["segura"]:
                c["segura"] -= 1
            else:
                self.apagar_topo(c)
        if c["cabeca"] - c["topo"] > c["tam"]:
            self.apagar_topo(c)
        return c["topo"] >= h or (c["topo"] >= c["cabeca"] and c["cabeca"] >= h)

    def draw(self, t, dt, ch, co):
        self.acc += dt * random.uniform(14, 26)
        while self.acc >= 1:
            self.acc -= 1
            self.nova_coluna()
        vivas = []
        for c in self.colunas:
            c["acc"] += dt * c["vel"]
            acabou = False
            while c["acc"] >= 1 and not acabou:
                c["acc"] -= 1
                acabou = self.passo(c)
            if acabou:
                self.ocupadas.discard(c["x"])
            else:
                vivas.append(c)
        self.colunas = vivas
        sym, cor_ = self.sym, self.cor
        for _ in range(max(1, self.n // 400)):
            i = random.randrange(self.n)
            if sym[i] != " ":
                sym[i] = random.choice(self.CH)
                if random.random() < 0.2 and cor_[i] != self.PONTA:
                    cor_[i] = random.choice(self.TONS)
        ch[:] = sym
        co[:] = cor_
        if self.revela and self.revela <= t <= self.revela + 5:
            k = clamp(min((t - self.revela) / 1.2, (self.revela + 5 - t) / 1.2))
            for i in self.forma:
                if ch[i] == " ":
                    if random.random() < k:
                        ch[i], co[i] = random.choice(self.CH), misturar(0x0A2A0A, 0xD8FFD8, k)
                else:
                    co[i] = misturar(co[i], 0xFFFFFF, 0.85 * k)


class Plasma(Cena):
    """Ondas de plasma se misturando."""

    def iniciar(self):
        self.dist = [math.hypot(x - self.cx, (y - self.cy) * ASPECTO) for y in range(self.h) for x in range(self.w)]
        self.k = random.uniform(0.06, 0.12)

    def draw(self, t, dt, ch, co):
        w, h, k, pal, dist = self.w, self.h, self.k, self.pal, self.dist
        sx = [math.sin(x * k + t) for x in range(w)]
        sy = [math.sin(y * k * 2.2 - t * 0.7) for y in range(h)]
        sin = math.sin
        for y in range(h):
            base = y * w
            syy = sy[y]
            for x in range(w):
                i = base + x
                v = sx[x] + syy + sin((x + y * 2) * k * 0.6 + t * 1.3) + sin(dist[i] * k * 1.4 - t)
                v = (v + 4) / 8
                v = v * v * 1.25
                if v < 0.18:
                    ch[i] = " "
                else:
                    ch[i] = RAMPA[min(9, int(v * 9.99))]
                    co[i] = pal[min(NIVEIS - 1, int(v * (NIVEIS - 1)))]


class Tunel(Cena):
    """Túnel xadrez girando, voando pra dentro, com anéis coloridos."""

    def iniciar(self):
        raio = min(self.w, self.h * ASPECTO) / 2
        self.prof, self.ang, self.sombra = [], [], []
        for y in range(self.h):
            for x in range(self.w):
                dx, dy = (x - self.cx) / raio, (y - self.cy) * ASPECTO / raio
                r = math.hypot(dx, dy) + 1e-3
                self.prof.append(0.5 / r)
                self.ang.append(math.atan2(dy, dx) / (2 * math.pi) + 0.5)
                self.sombra.append(clamp(r * 1.3))
        self.giro = random.choice((-1, 1)) * random.uniform(0.2, 0.6)
        self.modo = random.choice(("arco", "arco", "duo", "mono"))
        if self.modo == "arco":
            self.tab = [[hsv(k / 48, 0.8, 0.1 + 0.9 * b / 15) for b in range(16)] for k in range(48)]
            self.kmul = 3
        elif self.modo == "duo":
            h1 = random.random()
            h2 = (h1 + random.uniform(0.3, 0.5)) % 1
            self.tab = [[hsv(h1 if k < 24 else h2, 0.85, 0.1 + 0.9 * b / 15) for b in range(16)] for k in range(48)]
            self.kmul = 24
        else:
            linha = [self.pal[int(b / 15 * (NIVEIS - 1))] for b in range(16)]
            self.tab = [linha] * 48
            self.kmul = 0

    def draw(self, t, dt, ch, co):
        prof, ang, sombra, tab, kmul = self.prof, self.ang, self.sombra, self.tab, self.kmul
        av, gv = t * 3.0, t * self.giro + math.sin(t * 0.4) * 0.3
        desloc = int(t * 6) if kmul == 3 else 0
        for i in range(self.n):
            s = sombra[i]
            if s < 0.06:
                ch[i] = " "
                continue
            u = int(prof[i] * 6 + av)
            v = int(ang[i] * 16 + gv + prof[i] * 1.5)
            linha = tab[(u * kmul + desloc) % 48]
            if (u + v) & 1:
                ch[i] = "#" if s > 0.5 else "+"
                co[i] = linha[int(s * 15)]
            else:
                ch[i] = "." if s > 0.3 else " "
                co[i] = linha[int(s * 5)]


class Estrelas(Cena):
    """Viagem na velocidade da luz, com estrelas de várias cores."""
    CORES = [0x9BB0FF, 0xAABFFF, 0xCAD7FF, 0xF8F7FF, 0xFFF4EA, 0xFFD2A1, 0xFFB56C, 0xFF8F6B, 0x9DFFE0, 0xF0A8FF]

    def iniciar(self):
        self.cores = self.CORES if random.random() < 0.75 else [self.pal[NIVEIS - 1], self.pal[20]]
        self.estrelas = [self.nova(random.uniform(0.05, 1)) for _ in range(int(self.n * 0.04))]
        self.vel = random.uniform(0.25, 0.5)

    def nova(self, z=1.0):
        return [random.uniform(-1, 1), random.uniform(-1, 1), z, random.choice(self.cores)]

    def draw(self, t, dt, ch, co):
        ch[:] = self.vazio
        w, h = self.w, self.h
        vel = self.vel * (1 + 0.6 * math.sin(t * 0.3))
        for s in self.estrelas:
            pz = s[2]
            s[2] -= vel * dt
            if s[2] <= 0.02:
                s[:] = self.nova()
                continue
            c = s[3]
            for z, trilha in ((pz, True), (s[2], False)):
                x = int(self.cx + s[0] / z * w * 0.25)
                y = int(self.cy + s[1] / z * h * 0.25)
                if not (0 <= x < w and 0 <= y < h):
                    if not trilha:
                        s[:] = self.nova()
                    continue
                i = y * w + x
                v = 1 - z
                if trilha:
                    if ch[i] == " ":
                        ch[i], co[i] = ".", escala(c, 0.2 + 0.4 * v)
                else:
                    ch[i] = "." if z > 0.7 else "+" if z > 0.4 else "*" if z > 0.2 else "@"
                    co[i] = misturar(c, 0xFFFFFF, 0.6) if z < 0.12 else escala(c, 0.35 + 0.65 * v)


class Fogo(Cena):
    """Fogo subindo do chão."""

    def __init__(self, paleta):
        super().__init__("fogo" if random.random() < 0.6 else "verde")

    def iniciar(self):
        self.calor = [0.0] * (self.w * (self.h + 2))
        self.decai = 0.35 ** (1 / self.h)

    def draw(self, t, dt, ch, co):
        w, h, c, pal, decai = self.w, self.h, self.calor, self.pal, self.decai
        fundo_ = (h + 1) * w
        for x in range(w):
            c[fundo_ + x] = random.random() ** 0.4 if random.random() < 0.85 else 0.0
            c[h * w + x] = (c[fundo_ + x] + c[h * w + x]) * 0.5
        for y in range(h):
            base, abaixo = y * w, (y + 1) * w
            for x in range(w):
                e = c[abaixo + x - 1] if x else 0.0
                d = c[abaixo + x + 1] if x < w - 1 else 0.0
                v = (e + c[abaixo + x] * 2 + d) * 0.25 * decai
                if random.random() < 0.08:
                    v *= 0.85
                c[base + x] = v
                i = base + x
                if v < 0.08:
                    ch[i] = " "
                else:
                    ch[i] = RAMPA[min(9, int(v * 11))]
                    co[i] = pal[min(NIVEIS - 1, int(v * 1.3 * (NIVEIS - 1)))]


class Ondas(Cena):
    """Gotas caindo num lago escuro."""

    def iniciar(self):
        self.gotas = []
        self.prox = 0.0

    def draw(self, t, dt, ch, co):
        if t >= self.prox and len(self.gotas) < 4:
            self.gotas.append((random.uniform(0, self.w), random.uniform(0, self.h), t))
            self.prox = t + random.uniform(0.6, 1.6)
        self.gotas = [g for g in self.gotas if t - g[2] < 6]
        ondas = [(gx, gy, t - gt, (t - gt) * 14, math.exp(-(t - gt) * 0.55)) for gx, gy, gt in self.gotas]
        w, pal, sin = self.w, self.pal, math.sin
        for y in range(self.h):
            base = y * w
            for x in range(w):
                s = 0.0
                for gx, gy, idade, frente, env in ondas:
                    d = math.hypot(x - gx, (y - gy) * ASPECTO)
                    if d < frente and d > frente - 40:
                        s += sin(d * 0.55 - idade * 7.7) * env * (1 - (frente - d) / 40)
                i = base + x
                v = abs(s)
                if v < 0.1:
                    ch[i] = " "
                else:
                    ch[i] = char_rampa(v)
                    co[i] = cor(pal, v)


class Vida(Cena):
    """Jogo da Vida de Conway (as células mais velhas mudam de cor)."""

    def iniciar(self):
        self.vivo = [random.random() < 0.25 for _ in range(self.n)]
        self.idade = [0] * self.n
        self.brilho = [0.0] * self.n
        self.acc = 0.0

    def passo(self):
        w, h, v, idade = self.w, self.h, self.vivo, self.idade
        novo = [False] * self.n
        nova_idade = [0] * self.n
        pop = 0
        for y in range(h):
            ya, yb = ((y - 1) % h) * w, ((y + 1) % h) * w
            yc = y * w
            for x in range(w):
                xa, xb = (x - 1) % w, (x + 1) % w
                k = (v[ya + xa] + v[ya + x] + v[ya + xb] + v[yc + xa] + v[yc + xb]
                     + v[yb + xa] + v[yb + x] + v[yb + xb])
                i = yc + x
                if k == 3 or (k == 2 and v[i]):
                    novo[i] = True
                    nova_idade[i] = idade[i] + 1 if v[i] else 0
                    pop += 1
        self.vivo, self.idade = novo, nova_idade
        if pop < self.n * 0.04 or random.random() < 0.02:
            cx, cy = random.randrange(w), random.randrange(h)
            for _ in range(self.n // 30):
                x = (cx + int(random.gauss(0, w / 8))) % w
                y = (cy + int(random.gauss(0, h / 8))) % h
                self.vivo[y * w + x] = True
                self.idade[y * w + x] = 0

    def draw(self, t, dt, ch, co):
        self.acc += dt
        if self.acc >= 0.1:
            self.acc = 0.0
            self.passo()
        vivo, idade, b, pal = self.vivo, self.idade, self.brilho, self.pal
        dec = math.exp(-dt * 3)
        for i in range(self.n):
            if vivo[i]:
                b[i] = 1.0
                ch[i], co[i] = "█", pal[max(12, NIVEIS - 1 - idade[i])]
                continue
            v = b[i] * dec
            b[i] = v
            if v < 0.12:
                ch[i] = " "
            else:
                ch[i] = "▒" if v > 0.5 else "░"
                co[i] = pal[int(v * 0.7 * (NIVEIS - 1))]


class Rosca(Cena):
    """Rosca 3D girando, com luz."""

    def iniciar(self):
        self.R1, self.R2, self.K2 = 1.0, 2.0, 5.0
        self.K1 = self.h * self.K2 * 0.42 / (self.R1 + self.R2)
        nt, nf = max(24, int(self.h * 0.9)), max(80, int(self.h * 3.2))
        self.cs_t = [(math.cos(a), math.sin(a)) for a in (i * 2 * math.pi / nt for i in range(nt))]
        self.cs_f = [(math.cos(a), math.sin(a)) for a in (i * 2 * math.pi / nf for i in range(nf))]
        self.zbuf = [0.0] * self.n

    def draw(self, t, dt, ch, co):
        ch[:] = self.vazio
        zb = self.zbuf
        zb[:] = [0.0] * self.n
        w, h, pal, R1, R2, K1, K2 = self.w, self.h, self.pal, self.R1, self.R2, self.K1, self.K2
        cA, sA, cB, sB = math.cos(t * 0.9), math.sin(t * 0.9), math.cos(t * 0.5), math.sin(t * 0.5)
        lum = ".,-~:;=!*#$@"
        for ct, st in self.cs_t:
            cx_ = R2 + R1 * ct
            cy_ = R1 * st
            for cf, sf in self.cs_f:
                x = cx_ * (cB * cf + sA * sB * sf) - cy_ * cA * sB
                y = cx_ * (sB * cf - sA * cB * sf) + cy_ * cA * cB
                z = K2 + cA * cx_ * sf + cy_ * sA
                oz = 1 / z
                px = int(self.cx + K1 * ASPECTO * x * oz)
                py = int(self.cy - K1 * y * oz)
                if 0 <= px < w and 0 <= py < h:
                    i = py * w + px
                    if oz > zb[i]:
                        L = cf * ct * sB - cA * ct * sf - sA * st + cB * (cA * st - ct * sA * sf)
                        zb[i] = oz
                        if L > 0:
                            v = L / 1.42
                            ch[i] = lum[min(11, int(v * 11.99))]
                            co[i] = cor(pal, 0.25 + v * 0.75)
                        else:
                            ch[i] = "."
                            co[i] = pal[5]


class Hex(Cena):
    """Terminal de hacker despejando memória."""
    paletas = ["verde", "verde", "ambar", "ciano"]
    MSGS = ["ACCESS GRANTED", "decrypting sector", "handshake ok", "injecting payload",
            "tracing route", "bypassing firewall", "root@localhost:~#", "compiling kernel",
            "scanning ports", "uplink established", "SIGNAL LOCKED", "brute forcing hash",
            "uploading rola.exe", "rola.exe has stopped responding", "mounting /dev/rola"]

    def iniciar(self):
        self.addr = random.randrange(0x7F000000, 0x7FFFFFFF)
        self.linhas = [self.linha() for _ in range(self.h)]
        self.acc = 0.0
        self.vel = random.uniform(8, 20)

    def linha(self):
        if random.random() < 0.06:
            m = "[{}] {} 0x{:08x}".format(random.choice(("OK", "!!", "..", "**")), random.choice(self.MSGS),
                                           random.getrandbits(32))
            return (m.ljust(self.w)[: self.w], True)
        partes = []
        while sum(len(p) for p in partes) < self.w:
            self.addr += 16
            bs = [random.getrandbits(8) for _ in range(8)]
            txt = "".join(chr(b) if 33 <= b < 127 else "." for b in bs)
            partes.append("{:08x}  {}  {}    ".format(self.addr & 0xFFFFFFFF, " ".join("%02x" % b for b in bs), txt))
        return ("".join(partes)[: self.w], False)

    def draw(self, t, dt, ch, co):
        self.acc += dt * self.vel
        while self.acc >= 1:
            self.acc -= 1
            self.linhas.pop(0)
            self.linhas.append(self.linha())
        w, h, pal = self.w, self.h, self.pal
        for y, (txt, msg) in enumerate(self.linhas):
            base = y * w
            idade = (y + 1) / h
            c = 0xE0FFE0 if msg else pal[int((0.15 + idade * 0.6) * (NIVEIS - 1))]
            quente = pal[NIVEIS - 1]
            for x in range(w):
                i = base + x
                ch[i] = txt[x]
                co[i] = quente if (not msg and y == h - 1) else c


class Synthwave(Cena):
    """Pôr do sol synthwave: sol listrado, montanhas e grade neon correndo."""
    combinavel = False
    TEMAS = [
        dict(ceu=(0x07001A, 0x2B0A4F, 0x9C1F6E), sol=(0xFFE66B, 0xFF8C42, 0xFF2E7E), monte=0x1A0636,
             crista=0x2DE2FF, chao=0x06000F, grade=0xFF2BD6, nevoa=0xB02A80),
        dict(ceu=(0x00000A, 0x001B36, 0x0B5A8C), sol=(0xC8FFFF, 0x4CC9FF, 0x3B5BFF), monte=0x03132B,
             crista=0xFF4DF2, chao=0x00040C, grade=0x00F0FF, nevoa=0x1470A8),
        dict(ceu=(0x000000, 0x001A0A, 0x0B5A2A), sol=(0xF0FFB8, 0x86FF6B, 0x1FBF4A), monte=0x001407,
             crista=0x86FF6B, chao=0x000500, grade=0x33FF66, nevoa=0x127A3A),
    ]

    def iniciar(self):
        T = self.T = random.choices(self.TEMAS, weights=(0.6, 0.25, 0.15))[0]
        pw, ph = self.pw, self.ph = self.w, self.h * 2
        hor = self.hor = int(ph * 0.56)
        c0, c1, c2 = T["ceu"]
        self.ceu = []
        for py in range(hor):
            f = py / max(1, hor - 1)
            c = misturar(c0, c1, f / 0.6) if f < 0.6 else misturar(c1, c2, (f - 0.6) / 0.4)
            self.ceu.extend([c] * pw)
        self.estrelas = []
        for _ in range(int(pw * hor * 0.012)):
            py = int(random.random() ** 1.6 * hor * 0.7)
            self.estrelas.append((py * pw + random.randrange(pw), random.uniform(0.3, 1), random.uniform(0, 6.3)))
        R = self.R = ph * 0.3
        scx, scy = pw / 2, hor - R * 0.25
        s0, s1, s2 = T["sol"]
        self.sol = []
        for py in range(max(0, int(scy - R)), hor):
            for px in range(max(0, int(scx - R)), min(pw, int(scx + R) + 1)):
                if (px + 0.5 - scx) ** 2 + (py + 0.5 - scy) ** 2 <= R * R:
                    f = (py - (scy - R)) / (2 * R)
                    c = misturar(s0, s1, f / 0.5) if f < 0.5 else misturar(s1, s2, (f - 0.5) / 0.5)
                    self.sol.append((py * pw + px, f, c))
        self.montes = self.gerar_montes(T)
        self.K = (ph - hor) * 3.0
        self.foco = ph - hor
        self.px = [0] * (pw * ph)

    def gerar_montes(self, T):
        pw, hor = self.pw, self.hor

        def perfil(amp, passo):
            pts = [random.random() for _ in range(pw // passo + 3)]
            alt = []
            for x in range(pw):
                k = x / passo
                i = int(k)
                fr = k - i
                vale = 0.25 + 0.75 * clamp(abs(x - pw / 2) / (pw * 0.32))
                alt.append(int(amp * vale * (0.2 + 0.8 * (pts[i] * (1 - fr) + pts[i + 1] * fr))))
            return alt

        longe = perfil(self.ph * 0.17, random.randint(8, 12))
        perto = perfil(self.ph * 0.1, random.randint(5, 8))
        cor_longe = misturar(T["monte"], T["nevoa"], 0.3)
        crista_longe = misturar(cor_longe, T["crista"], 0.35)
        mapa = {}
        for x in range(pw):
            for py in range(hor - longe[x], hor):
                mapa[py * pw + x] = crista_longe if py == hor - longe[x] else cor_longe
            hp = perto[x]
            hmin = min(perto[x - 1] if x else hp, perto[x + 1] if x < pw - 1 else hp, hp)
            for py in range(hor - hp, hor):
                if py <= hor - hmin:
                    mapa[py * pw + x] = T["crista"]
                elif (x + py) % 8 == 0:
                    mapa[py * pw + x] = escala(T["crista"], 0.18)
                else:
                    mapa[py * pw + x] = T["monte"]
        return list(mapa.items())

    def draw(self, t, dt, ch, co):
        T, pw, ph, hor, px = self.T, self.pw, self.ph, self.hor, self.px
        px[: hor * pw] = self.ceu
        for idx, b, fase in self.estrelas:
            px[idx] = escala(0xFFFFFF, b * (0.55 + 0.45 * math.sin(t * 2.3 + fase)))
        diam = self.R * 2
        for idx, f, c in self.sol:
            if f > 0.33 and (f * diam * 0.9 - t * 3.0) % 5.0 < (f - 0.33) * 10:
                continue
            px[idx] = c
        for idx, c in self.montes:
            px[idx] = c
        px[hor * pw:(hor + 1) * pw] = [misturar(T["grade"], 0xFFFFFF, 0.35)] * pw
        rolar = t * 2.2
        K, foco, cxp = self.K, self.foco, pw / 2
        grade, nevoa, chao = T["grade"], T["nevoa"], T["chao"]
        brilho = misturar(nevoa, 0xFFFFFF, 0.15)
        for py in range(hor + 1, ph):
            dy = py - hor
            z = K / dy
            neb = clamp((z - 4) / 45)
            cl = misturar(grade, nevoa, neb)
            cb = misturar(chao, nevoa, neb * 0.35)
            b = py * pw
            z0, z1 = K / (dy - 0.5), K / (dy + 0.5)
            spp = foco / z
            if z0 - z1 >= 1 or spp < 1.6:
                # longe demais pra ver linha por linha: só a névoa brilhando no horizonte
                c = misturar(misturar(cb, cl, 0.3), brilho, math.exp(-dy / 3.0))
                px[b:b + pw] = [c] * pw
                continue
            if int(z0 + rolar) != int(z1 + rolar):
                px[b:b + pw] = [misturar(cb, cl, 1.4 - (z0 - z1) * 1.2)] * pw
                continue
            px[b:b + pw] = [cb] * pw
            n = int(cxp / spp) + 1
            for k in range(-n, n + 1):
                X = int(cxp + k * spp)
                if 0 <= X < pw:
                    px[b + X] = cl
        pixels_para_celulas(px, self.w, self.h, ch, co)


