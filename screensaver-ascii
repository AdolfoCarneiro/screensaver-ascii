# ---------------------------------------------------------------- cores

def rgb(r, g, b):
    r = 0 if r < 0 else 255 if r > 255 else int(r)
    g = 0 if g < 0 else 255 if g > 255 else int(g)
    b = 0 if b < 0 else 255 if b > 255 else int(b)
    return (r << 16) | (g << 8) | b


def clamp(v):
    return 0.0 if v < 0 else 1.0 if v > 1 else v


def escala(c, f):
    return rgb(((c >> 16) & 255) * f, ((c >> 8) & 255) * f, (c & 255) * f)


def misturar(a, b, t):
    t = clamp(t)
    return rgb(((a >> 16) & 255) * (1 - t) + ((b >> 16) & 255) * t,
               ((a >> 8) & 255) * (1 - t) + ((b >> 8) & 255) * t,
               (a & 255) * (1 - t) + (b & 255) * t)


def hsv(h, s=1.0, v=1.0):
    r, g, b = colorsys.hsv_to_rgb(h % 1.0, clamp(s), clamp(v))
    return rgb(r * 255, g * 255, b * 255)


def fundo(fg, bg):
    return fg | (bg << 24) | BG


def apagar(k):
    """Metade do brilho (usada pra cena de baixo nos combos)."""
    if k & BG:
        return ((k & 0xFFFFFF) >> 1 & 0x7F7F7F) | ((((k >> 24) & 0xFFFFFF) >> 1 & 0x7F7F7F) << 24) | BG
    return (k >> 1) & 0x7F7F7F


def lut(fn):
    out = []
    for i in range(NIVEIS):
        r, g, b = fn(i / (NIVEIS - 1))
        out.append(rgb(r, g, b))
    return out


def lut_hsv(fn):
    def cor_(v):
        h, s, b = fn(v)
        r, g, bb = colorsys.hsv_to_rgb(h % 1.0, clamp(s), clamp(b))
        return r * 255, g * 255, bb * 255
    return lut(cor_)


