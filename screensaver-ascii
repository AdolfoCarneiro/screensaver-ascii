# ------------------------------------------------------ texto e pixels

def escrever(ch, co, w, h, x, y, txt, c, opaco=False):
    if 0 <= y < h:
        base = y * w
        for k, s in enumerate(txt):
            xx = x + k
            if 0 <= xx < w and (opaco or s != " "):
                ch[base + xx] = s
                co[base + xx] = c


def quebrar(txt, largura):
    linhas, atual = [], ""
    for p in txt.split():
        if atual and len(atual) + 1 + len(p) > largura:
            linhas.append(atual)
            atual = p
        else:
            atual = atual + " " + p if atual else p
    if atual:
        linhas.append(atual)
    return linhas or [""]


def justificar(txt, largura):
    linhas, atual = [], []
    for p in txt.split():
        if atual and len(" ".join(atual + [p])) > largura:
            linhas.append(atual)
            atual = [p]
        else:
            atual.append(p)
    out = []
    for l in linhas:
        if len(l) == 1:
            out.append(l[0])
            continue
        falta = largura - sum(len(p) for p in l)
        vaos = len(l) - 1
        s = ""
        for k, p in enumerate(l[:-1]):
            s += p + " " * (falta // vaos + (1 if k < falta % vaos else 0))
        out.append(s + l[-1])
    if atual:
        out.append(" ".join(atual))
    return out


def pixels_para_celulas(px, w, h, ch, co):
    """Converte um buffer de pixels (w x 2h, cor 0 = vazio) em meios-blocos."""
    for y in range(h):
        a0 = 2 * y * w
        b0 = a0 + w
        c0 = y * w
        for x in range(w):
            a = px[a0 + x]
            b = px[b0 + x]
            i = c0 + x
            if a == b:
                if a:
                    ch[i] = "█"
                    co[i] = a
                else:
                    ch[i] = " "
            elif not b:
                ch[i] = "▀"
                co[i] = a
            elif not a:
                ch[i] = "▄"
                co[i] = b
            else:
                ch[i] = "▀"
                co[i] = a | (b << 24) | BG


