    def anim_status(self, a, d, nome, efeito):
        dx, dy = self.centro(d)
        ax, ay = self.centro(a)
        sent = 1 if a == "j" else -1
        R = random.uniform
        if nome in ("GROWL", "SUPERSONIC"):
            cor = 0x404040 if nome == "GROWL" else 0xF8E030
            ini = self.t
            while self.t - ini < 0.7:
                p = ((self.t - ini) * 3) % 1
                self.fx = [("arco", ax + sent * 8, ay - 6, 4 + p * 18, sent, cor), ("arco", ax + sent * 8, ay - 6, 4 + ((p + 0.5) % 1) * 18, sent, cor)]
                yield
        elif nome == "TAIL WHIP":
            ini = self.t
            while self.t - ini < 0.6:
                self.off[a][0] = 4 if int((self.t - ini) * 12) % 2 else -4
                yield
        elif nome in ("DEFENSE CURL", "HARDEN", "AGILITY"):
            yield from self.sobre_alvo(a, lambda x, y, p: [("anel", x, y, 30 * (1 - p) + 2, 0xF8F8F8)], 0.5, 0.03)
        elif nome in ("LEER", "SAND-ATTACK", "STRING SHOT"):
            cor = {"LEER": 0xF83030, "SAND-ATTACK": 0xC8A870, "STRING SHOT": 0xF0F0F0}[nome]
            yield from self.projeteis(a, d, (cor, cor, cor), 1.6, n=4, arco=6, dur=0.18, rastro=False)
        elif efeito == "par":
            yield from self.sobre_alvo(d, lambda x, y, p: [("anel", x, y, 3 + ((p * 3) % 1) * 22, 0xF8E030)], 0.8, 0.03)
        elif efeito in ("sono", "veneno"):
            cor = 0xF098C8 if efeito == "sono" else 0xA048C8
            yield from self.sobre_alvo(d, lambda x, y, p: [("disco", x + R(-18, 18), y - 30 + p * 40 + R(-4, 4), 1.4, cor)
                                                            for _ in range(14)], 0.8, 0.05)
        elif efeito == "semente":
            for n in range(2):
                ini = self.t
                while self.t - ini < 0.4:
                    p = (self.t - ini) / 0.4
                    x = ax + (dx - ax) * p + n * 6
                    y = ay + (dy - ay) * p - math.sin(p * math.pi) * 20
                    self.fx = [("disco", x, y, 2, 0x906830), ("disco", x - 0.5, y - 0.5, 0.8, 0xC8A060)]
                    yield
        elif efeito == "conf":
            yield from self.sobre_alvo(d, lambda x, y, p: [("disco", x + math.cos(p * 20 + k * 2.1) * 16, y - 24 + math.sin(p * 20 + k * 2.1) * 4,
                                                             1.8, 0xF8E030) for k in range(3)], 0.8, 0.03)
        self.fx = []
        self.off[a] = [0, 0]

    # --- desenho (em coordenadas do GBA, 240x160)

    def ponto(self, x, y, c):
        x, y = int(x) + self.ox, int(y) + self.oy
        if 0 <= x < self.vw and 0 <= y < self.vh:
            self.px[y * self.vw + x] = c

    def ret(self, x0, y0, x1, y1, c):
        vw, px = self.vw, self.px
        x0, x1 = max(0, int(x0) + self.ox), min(vw, int(x1) + self.ox)
        if x1 <= x0:
            return
        linha = [c] * (x1 - x0)
        for y in range(max(0, int(y0) + self.oy), min(self.vh, int(y1) + self.oy)):
            px[y * vw + x0:y * vw + x1] = linha

    def disco(self, x, y, r, c):
        for yy in range(int(y - r), int(y + r) + 1):
            for xx in range(int(x - r), int(x + r) + 1):
                if (xx + 0.5 - x) ** 2 + (yy + 0.5 - y) ** 2 <= r * r:
                    self.ponto(xx, yy, c)

    def anel(self, x, y, r, c, sentido=0):
        for yy in range(int(y - r) - 1, int(y + r) + 2):
            for xx in range(int(x - r) - 1, int(x + r) + 2):
                if sentido and (xx - x) * sentido < 0:
                    continue
                if abs(math.hypot(xx + 0.5 - x, yy + 0.5 - y) - r) < 0.7:
                    self.ponto(xx, yy, c)

    def linha(self, x0, y0, x1, y1, c, esp=0):
        n = int(max(abs(x1 - x0), abs(y1 - y0))) + 1
        for k in range(n + 1):
            x, y = x0 + (x1 - x0) * k / n, y0 + (y1 - y0) * k / n
            self.ponto(x, y, c)
            if esp:
                self.ponto(x + 1, y, c)
                self.ponto(x, y + 1, c)

    def estrela(self, x, y, r, c):
        self.linha(x - r, y, x + r, y, c)
        self.linha(x, y - r, x, y + r, c)
        d = r * 0.5
        self.linha(x - d, y - d, x + d, y + d, c)
        self.linha(x - d, y + d, x + d, y - d, c)

    def tri(self, x0, y0, x1, y1, x2, y2, c):
        for yy in range(int(min(y0, y1, y2)), int(max(y0, y1, y2)) + 1):
            for xx in range(int(min(x0, x1, x2)), int(max(x0, x1, x2)) + 1):
                px_, py_ = xx + 0.5, yy + 0.5
                d1 = (px_ - x1) * (y0 - y1) - (x0 - x1) * (py_ - y1)
                d2 = (px_ - x2) * (y1 - y2) - (x1 - x2) * (py_ - y2)
                d3 = (px_ - x0) * (y2 - y0) - (x2 - x0) * (py_ - y0)
                if not ((d1 < 0 or d2 < 0 or d3 < 0) and (d1 > 0 or d2 > 0 or d3 > 0)):
                    self.ponto(xx, yy, c)

    def caixa_px(self, x0, y0, x1, y1, fill, borda, borda2=None, sombra=None):
        if sombra:
            self.ret(x0 + 1, y0 + 1, x1 + 1, y1 + 1, sombra)
        self.ret(x0 + 1, y0, x1 - 1, y1, borda)
        self.ret(x0, y0 + 1, x1, y1 - 1, borda)
        if borda2:
            self.ret(x0 + 2, y0 + 1, x1 - 2, y1 - 1, borda2)
            self.ret(x0 + 1, y0 + 2, x1 - 1, y1 - 2, borda2)
            self.ret(x0 + 3, y0 + 2, x1 - 3, y1 - 2, fill)
            self.ret(x0 + 2, y0 + 3, x1 - 2, y1 - 3, fill)
        else:
            self.ret(x0 + 1, y0 + 1, x1 - 1, y1 - 1, fill)

    def escrever_px(self, x, y, s, cor, sombra=None):
        for passo, c, dx in ((0, sombra, 1), (1, cor, 0)):
            if c is None:
                continue
            xx = x
            for letra in s:
                if letra == " ":
                    xx += 3
                    continue
                g = FONTE_GBA.get(letra) or FONTE_GBA["?"]
                for ry, row in enumerate(g):
                    for rx, p in enumerate(row):
                        if p == "#":
                            self.ponto(xx + rx + dx, y + ry + dx, c)
                            if dx:
                                self.ponto(xx + rx + 1, y + ry, c)
                                self.ponto(xx + rx, y + ry + 1, c)
                xx += len(g[0]) + 1

    def mini_hp(self, x, y, txt="HP", cor=0xF8B800, sombra=None):
        for k, letra in enumerate(txt):
            for ry, row in enumerate(MINI_HP[letra]):
                for rx, p in enumerate(row):
                    if p == "#":
                        if sombra:
                            self.ponto(x + k * 4 + rx + 1, y + ry + 1, sombra)
                        self.ponto(x + k * 4 + rx, y + ry, cor)

    def nivel(self, x_fim, y, n):
        num = str(n)
        x = x_fim - largura_gba(num) - 8
        self.mini_hp(x, y + 2, "Lv", self.TEXTO, self.TEXTO_SOMBRA)
        self.escrever_px(x + 8, y, num, self.TEXTO, self.TEXTO_SOMBRA)

    def desenhar_sprite(self, lado):
        if not self.vis[lado] or self.pisca[lado]:
            return
        grade = self.lut[lado]["spr"]
        H, W = len(grade), len(grade[0])
        x0, y0 = self.pos(lado)
        if lado == "j" and self.balanco:
            y0 += 1 if int(self.t * 4) % 2 else 0
        f, br, tinta, af = self.escala_spr[lado], self.branco[lado], self.tinta[lado], self.afunda[lado]
        lim = min(y0 + self.lut[lado]["caixa"][3] + 1 if af else 112, 112)
        if f < 0.999:
            sw, sh = max(1, int(W * f)), max(1, int(H * f))
            ox, oy = x0 + (W - sw) // 2, y0 + H - sh
            for yy in range(sh):
                if oy + yy >= lim:
                    continue
                linha_ = grade[min(H - 1, int(yy / f))]
                for xx in range(sw):
                    c = linha_[min(W - 1, int(xx / f))]
                    if c:
                        self.ponto(ox + xx, oy + yy, misturar(c, 0xFFFFFF, br) if br else c)
            return
        for yy in range(H):
            Y = y0 + yy + af
            if Y >= lim:
                continue
            linha_ = grade[yy]
            for xx in range(W):
                c = linha_[xx]
                if c:
                    if br:
                        c = misturar(c, 0xFFFFFF, br)
                    elif tinta:
                        c = misturar(c, tinta[0], tinta[1])
                    self.ponto(x0 + xx, Y, c)

    def cor_hp(self, r):
        return self.HP_CORES[0 if r > 0.5 else 1 if r > 0.2 else 2]

    def barra_hp(self, x, y, r):
        self.ret(x - 16, y - 2, x + 50, y + 5, self.PAINEL_BORDA)
        self.ret(x - 15, y - 1, x + 49, y + 4, self.BARRA_FUNDO)
        self.mini_hp(x - 13, y - 1)
        self.ret(x, y, x + 48, y + 3, 0x303838)
        n = int(round(48 * clamp(r)))
        if r > 0 and n == 0:
            n = 1
        claro, base = self.cor_hp(r)
        self.ret(x, y, x + n, y + 1, claro)
        self.ret(x, y + 1, x + n, y + 3, base)

    def painel_inimigo(self):
        e = self.lut["i"]
        x = 13 + self.painel_off["i"]
        self.caixa_px(x, 16, x + 100, 45, self.PAINEL, self.PAINEL_BORDA, sombra=self.PAINEL_SOMBRA)
        self.escrever_px(x + 8, 20, e["nome"], self.TEXTO, self.TEXTO_SOMBRA)
        if e["genero"]:
            self.escrever_px(x + 9 + largura_gba(e["nome"]), 20, e["genero"], 0x3890F8 if e["genero"] == "♂" else 0xF86060, self.TEXTO_SOMBRA)
        self.nivel(x + 94, 20, e["nivel"])
