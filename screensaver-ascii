        self.ret(x + 30, 106, x + 98, 109, self.PAINEL_BORDA)
        self.ret(x + 31, 107, x + 97, 108, 0x505858)
        self.ret(x + 31, 107, x + 31 + int(66 * self.expv), 108, 0x40C8F8)
        if j["status"]:
            self.etiqueta_status(x + 10, 90, j["status"])

    def etiqueta_status(self, x, y, st):
        txt, cor = {"par": ("PAR", 0xC8A800), "sono": ("SLP", 0x8888A0), "veneno": ("PSN", 0xA048C8)}[st]
        self.ret(x, y, x + 21, y + 9, cor)
        self.escrever_px(x + 2, y + 1, txt, 0xF8F8F8)

    def caixa_texto(self):
        self.caixa_px(0, 112, 240, 160, self.CAIXA, self.CAIXA_BORDA2, borda2=self.CAIXA_BORDA)
        if self.menu and self.menu[0] == "golpes":
            J = self.lut["j"]
            sel = self.menu[1]
            self.caixa_px(0, 112, 162, 160, self.MENU, self.MENU_BORDA, borda2=self.MENU_BORDA2)
            self.caixa_px(160, 112, 240, 160, self.MENU, self.MENU_BORDA, borda2=self.MENU_BORDA2)
            for k, (x, y) in enumerate(((12, 122), (92, 122), (12, 140), (92, 140))):
                if k < len(J["golpes"]):
                    self.escrever_px(x, y, J["golpes"][k][0], self.MENU_TEXTO, self.MENU_SOMBRA)
                    if k == sel:
                        self.escrever_px(x - 7, y, "▶", self.MENU_TEXTO)
            g = J["golpes"][sel]
            self.escrever_px(168, 118, "PP", self.MENU_TEXTO, self.MENU_SOMBRA)
            pp = f"{J['pp'][sel]}/{g[2]}"
            self.escrever_px(232 - largura_gba(pp), 118, pp, self.MENU_TEXTO, self.MENU_SOMBRA)
            self.escrever_px(168, 131, "TYPE/", self.MENU_TEXTO, self.MENU_SOMBRA)
            tp = self.tipo_golpe(g)
            self.escrever_px(232 - largura_gba(tp), 143, tp, self.MENU_TEXTO, self.MENU_SOMBRA)
            return
        self.escrever_px(11, 122, self.texto[0], 0xF8F8F8, 0x687080)
        self.escrever_px(11, 140, self.texto[1], 0xF8F8F8, 0x687080)
        if self.menu and self.menu[0] == "cmd":
            sel = self.menu[1]
            self.caixa_px(120, 112, 240, 160, self.MENU, self.MENU_BORDA, borda2=self.MENU_BORDA2)
            for k, (s, x, y) in enumerate((("FIGHT", 138, 122), ("BAG", 194, 122), ("POKéMON", 138, 140), ("RUN", 194, 140))):
                self.escrever_px(x, y, s, self.MENU_TEXTO, self.MENU_SOMBRA)
                if k == sel:
                    self.escrever_px(x - 8, y, "▶", self.MENU_TEXTO)
        elif self.seta and int(self.t * 3) % 2 == 0:
            self.escrever_px(222, 146, "▼", 0xF85050)

    def draw(self, t, dt, ch, co):
        self.t, self.dt = t, dt
        next(self.gen)
        px = self.px
        px[:] = self.fundo
        for lado in ("i", "j"):
            ox = self.plat_off[0 if lado == "i" else 1]
            for x, y, c in self.plat[lado]:
                if y < 112:
                    self.ponto(x + ox, y, c)
        if self.lut:
            self.desenhar_sprite("i")
            self.desenhar_sprite("j")
        for f in self.fx:
            tipo = f[0]
            if tipo == "disco":
                self.disco(*f[1:])
            elif tipo == "anel":
                self.anel(*f[1:])
            elif tipo == "arco":
                self.anel(f[1], f[2], f[3], f[5], sentido=f[4])
            elif tipo == "linha":
                self.linha(*f[1:])
            elif tipo == "estrela":
                self.estrela(*f[1:])
            elif tipo == "tri":
                self.tri(*f[1:])
            elif tipo == "coluna":
                x, c, alt = f[1], f[2], f[3]
                self.ret(x, 112 - alt, x + 1, 112, c)
        if self.bola:
            bx, by = self.bola
            for yy in range(int(by) - 6, int(by) + 7):
                for xx in range(int(bx) - 6, int(bx) + 7):
                    d = math.hypot(xx + 0.5 - bx, yy + 0.5 - by)
                    if d <= 5.5:
                        c = 0x303030 if d > 4.6 or abs(yy + 0.5 - by) < 0.8 else 0xF83838 if yy + 0.5 < by else 0xF8F8F8
                        if d < 1.8:
                            c = 0xF8F8F8 if d < 1.1 else 0x303030
                        self.ponto(xx, yy, c)
        if self.lut and self.info["i"]:
            self.painel_inimigo()
        if self.lut and self.info["j"]:
            self.painel_jogador()
        self.caixa_texto()
        if self.cortina > 0:
            n = int(self.cortina * self.vw)
            for y in range(0, self.vh, 4):
                a0, a1 = (0, n) if (y // 4) % 2 == 0 else (self.vw - n, self.vw)
                for yy in range(y, min(self.vh, y + 4)):
                    px[yy * self.vw + a0:yy * self.vw + a1] = [0x000000] * (a1 - a0)
        if self.flash > 0:
            px[:] = [misturar(c, 0xFFFFFF, self.flash) for c in px]
        if self.escuro > 0:
            px[:] = [misturar(c, self.cor_fade, self.escuro) for c in px]
        pixels_para_celulas_k(px, self.vw, self.k, self.w, self.h, ch, co,
                              self.tremor * self.k)


