def letreiro(px, w, ph, txt, cx, cy, esc, cor, contorno=None):
    """Texto na fonte 5x5 escrito direto num buffer de pixels, centrado em (cx, cy)."""
    g = texto_grade(txt, esc)
    gh, gw = len(g), len(g[0])
    x0, y0 = int(cx - gw / 2), int(cy - gh / 2)
    cheios = [(x0 + xx, y0 + yy) for yy in range(gh) for xx in range(gw) if g[yy][xx]]
    if contorno is not None:
        for x, y in cheios:
            for ox in (-1, 0, 1):
                for oy in (-1, 0, 1):
                    if 0 <= x + ox < w and 0 <= y + oy < ph:
                        px[(y + oy) * w + x + ox] = contorno
    for x, y in cheios:
        if 0 <= x < w and 0 <= y < ph:
            px[y * w + x] = cor


def esc_letreiro(txt, largura, maximo=4):
    """Maior escala da fonte 5x5 em que txt cabe na largura (pelo menos 1)."""
    return max(1, min(maximo, int(largura // max(1, 6 * len(txt) - 1))))


def chip(ch, co, w, h, x, y, txt, fg, bg):
    """Etiqueta com fundo (placar, letreiro); devolve onde ela termina."""
    escrever(ch, co, w, h, x, y, txt.replace(" ", NBSP), fundo(fg, bg))
    return x + len(txt)


