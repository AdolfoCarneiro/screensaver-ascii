def blit(ch, co, w, h, pixels):
    """Desenha pixels soltos {(x, py): cor} por cima das células, em meios-blocos."""
    celulas = {}
    for (x, py), c in pixels.items():
        if 0 <= x < w and 0 <= py < 2 * h:
            celulas.setdefault((x, py >> 1), [0, 0])[py & 1] = c
    for (x, row), (a, b) in celulas.items():
        i = row * w + x
        if a and b:
            ch[i], co[i] = ("█", a) if a == b else ("▀", a | (b << 24) | BG)
        elif a:
            ch[i], co[i] = "▀", a
        else:
            ch[i], co[i] = "▄", b


def arte_pixels(arte, x0, y0, esc, cores, px=None, ey=None):
    """Arte (lista de strings) -> {(x, py): cor}; cores mapeia caractere -> cor.
    ey é a escala vertical (padrão: igual à horizontal)."""
    px = {} if px is None else px
    ey = esc if ey is None else ey
    for ay, linha in enumerate(arte):
        for ax, s in enumerate(linha):
            c = cores.get(s)
            if c:
                traco = y0 + ay * ey + ey - 1 - ey // 3
                for yy in range(y0 + ay * ey, y0 + ay * ey + ey):
                    cc = c if s != "e" or ey == 1 or yy == traco else cores.get("#", c)
                    for xx in range(x0 + ax * esc, x0 + ax * esc + esc):
                        px[(xx, yy)] = cc
    return px


class Clawd(Cena):
    """O Clawd (mascote do Claude Code) caçando bugs no meio do código."""
    combinavel = False
    peso = 0.7
    duracao = (45, 60)
    LARANJA = 0xD97757
    SPIN = "·✢✳✶✻✽✻✶✳✢"
    VERBOS = ["Claudando", "Ponderando", "Osmosando", "Matutando", "Maquinando", "Percolando", "Cogitando",
              "Vibrando", "Fermentando", "Conjurando", "Perambulando", "Espeleologando", "Domando", "Gambiarrando",
              "Ruminando", "Buzinando", "Marinando", "Cozinhando", "Depurando", "Caçando bugs", "Refatorando"]
    FALAS_PEGOU = ["Você tem toda razão!", "Você tem toda razão!", "Achei o bug!", "Corrigido ✓",
                   "Mais um!", "Era um off-by-one.", "Faltava um await.", "Era só um typo.", "null de novo...",
                   "Quem escreveu isso? Ah, fui eu.", "Nada que um print não resolva.", "Race condition. Clássico.",
                   "Mais fácil que ganhar do Tottenham."]
    FALAS_ERROU = ["Quase!", "Volta aqui!", "Hmm, escorregou.", "Deixa eu reler o stack trace..."]
    FALAS_IDEIA = ["Já sei!", "Hmm... achei.", "Eureka!", "Ok, tenho um plano.", "Deixa comigo."]
    CORES_BUG = [0xFF5C5C, 0x7CFC7C, 0xB07CFF, 0xFFC857, 0x5CC8FF]
    NOMES = ["parse", "fetch_user", "render", "retry", "cache", "handler", "tokens", "payload", "config",
             "session", "queue", "buffer", "index", "result", "item", "node", "user", "data", "resp", "cb"]
    MOLDES = ["def {a}({b}, {c}):", "    if {b} is None:", "        return {c}", "    for {i} in range(len({b})):",
              "        {b}[{i}] = {a}({c})", "const {b} = await {a}({c});", "if (!{b}) throw new Error('{a}');",
              "    {b} += 1", "}}", "import {a}", "fn {a}(&mut self) -> Result<(), Error> {{",
              "    let {b} = {c}.clone();", "// TODO: {a} quebra quando {b} vem vazio", "# FIXME: {a} está lento",
              "    try:", "    except KeyError as e:", "        log.warning(e)", "{b}.map(({i}) => {a}({i}))",
              "    while not {b}.empty():", "return {{ ...{b}, {c} }};", "    {b} = {a}({c}) or {{}}",
              "@retry(times=3)", "class {A}:", "    assert {b} == {c}"]

    def iniciar(self):
        w, h = self.w, self.h
        self.esc = 2 if w >= 90 and h >= 30 else 1
        self.cw = 18 * self.esc
        self.chao = h - 3
        self.mini_rola = rola_pixels(0.12)
        self.x = random.uniform(0, max(1, w - self.cw))
        self.dir = 1
        self.pulo_px = 0.0
        self.andando = False
        self.t = self.dt = 0.0
        self.bugs, self.parts, self.flutua, self.minis = [], [], [], []
        self.fala, self.fala_t = "", -10.0
        self.pensando = None
        self.corrigidos = 0
        self.testes = random.randint(30, 55)
        self.verbo, self.prox_verbo = random.choice(self.VERBOS), random.uniform(5, 9)
        self.codigo = [self.linha_codigo() for _ in range(max(1, h - 8))]
        self.acc_cod = 0.0
        self.destaque = {}
        self.prox_mini = random.uniform(2, 6)
        for _ in range(random.randint(3, 5)):
            self.novo_bug(dentro=True)
        self.gen = self.comportamento()

    def linha_codigo(self):
        nomes = random.sample(self.NOMES, 3)
        txt = random.choice(self.MOLDES).format(a=nomes[0], b=nomes[1], c=nomes[2], i=random.choice("ijk"),
                                                A=nomes[0].title().replace("_", ""))
        return txt, (0x3E5E3E if txt.lstrip().startswith(("#", "//")) else 0x3A3A3A)

    def novo_bug(self, dentro=False):
        voa = random.random() < 0.3
        rola = not any(b["rola"] for b in self.bugs) and random.random() < (0.5 if OVOS else 0.06)
        v = random.uniform(4, 9) * random.choice((-1, 1))
        if dentro:
            x = random.uniform(0, self.w - 9)
        else:
            x = -9.0 if v > 0 else float(self.w)
        self.bugs.append({"x": x, "v": v, "voa": voa, "alt": random.uniform(5, 10) if voa else 0.0,
                          "cor": random.choice(self.CORES_BUG), "fase": random.uniform(0, 6),
                          "vira": random.uniform(1, 4), "rola": rola})

    def falar(self, txt):
        self.fala, self.fala_t = txt, self.t

    # --- comportamento do Clawd (gerador: cada yield é um quadro)

    def comportamento(self):
        while True:
            if random.random() < 0.22:
                yield from self.pensar()
            if not self.bugs:
                yield from self.esperar(0.4)
                continue
            meio = self.x + self.cw / 2
            alvo = min(self.bugs, key=lambda b: abs(b["x"] + 4.5 - meio) + random.uniform(0, 25))
            ini = self.t
            while alvo in self.bugs and self.t - ini < 6:
                d = (alvo["x"] + 4.5) - (self.x + self.cw / 2)
                self.dir = 1 if d > 0 else -1
                if abs(d) < self.cw * 0.45 + 6:
                    break
                self.x = max(0.0, min(self.w - self.cw, self.x + self.dir * 15 * self.dt))
                self.andando = True
                yield
            self.andando = False
            if alvo in self.bugs:
                yield from self.pular(alvo)

    def pular(self, alvo):
        x0 = self.x
        x1 = max(0.0, min(self.w - self.cw, alvo["x"] + 4.5 + alvo["v"] * 0.5 - self.cw / 2))
        altura = (6 + alvo["alt"]) * 2
        ini = self.t
        while self.t - ini < 0.55:
            p = (self.t - ini) / 0.55
            self.x = x0 + (x1 - x0) * suave(p)
            self.pulo_px = math.sin(p * math.pi) * altura
            yield
        self.pulo_px, self.x = 0.0, x1
        meio = self.x + self.cw / 2
        pegos = [b for b in self.bugs if abs(b["x"] + 4.5 - meio) < self.cw * 0.5 + 2]
        if pegos:
            for b in pegos:
                self.esmagar(b)
            if self.testes >= 100:
                yield from self.festa()
                return
            if any(b.get("rola") for b in pegos):
                self.falar("Isso não é bug, é feature.")
            elif random.random() < 0.55:
                self.falar(random.choice(self.FALAS_PEGOU))
            yield from self.esperar(0.4)
        else:
            if random.random() < 0.6:
                self.falar(random.choice(self.FALAS_ERROU))
            yield from self.esperar(0.5)

    def esmagar(self, b):
        self.bugs.remove(b)
        self.corrigidos += 1
        self.testes = min(100, self.testes + random.randint(5, 12))
        bx, by = b["x"] + 4.5, self.chao - 1 - b["alt"]
        for _ in range(24):
            a = random.uniform(0, 2 * math.pi)
            sp = random.uniform(6, 22)
            self.parts.append([bx, by, math.cos(a) * sp, math.sin(a) * sp * 0.5 - 6, random.choice("✻*+·"),
                               random.choice((b["cor"], self.LARANJA, 0xFFE0C8)), self.t, random.uniform(0.6, 1.2)])
        self.flutua.append([bx - 2, by - 2, "+1 ✓", 0x7CFC7C, self.t])
        if self.codigo:
            self.destaque[random.randrange(len(self.codigo))] = self.t

    def festa(self):
        self.falar("Todos os testes passando! ✓")
        for _ in range(60):
            self.parts.append([random.uniform(0, self.w), float(self.h), random.uniform(-6, 6), random.uniform(-30, -12),
                               random.choice("✻✳✶*"), hsv(random.random(), 0.6, 1.0), self.t, random.uniform(1.5, 2.5)])
        for _ in range(3):
            ini = self.t
            while self.t - ini < 0.35:
                self.pulo_px = math.sin((self.t - ini) / 0.35 * math.pi) * 8
                yield
            self.pulo_px = 0.0
        yield from self.esperar(1.2)
        self.testes = random.randint(20, 45)

    def pensar(self):
        self.pensando = (random.choice(self.VERBOS), self.t)
        yield from self.esperar(random.uniform(2.5, 4.5))
        self.pensando = None
        if random.random() < 0.5:
            self.falar(random.choice(self.FALAS_IDEIA))

    # --- desenho

    def draw(self, t, dt, ch, co):
        self.t, self.dt = t, dt
        next(self.gen)
        w, h = self.w, self.h
        for b in self.bugs:
            b["x"] += b["v"] * dt
            b["vira"] -= dt
            if b["vira"] <= 0:
                b["v"] = random.uniform(4, 9) * random.choice((-1, 1))
                b["vira"] = random.uniform(1, 4)
            if b["x"] < 0 and b["v"] < 0 or b["x"] > w - 9 and b["v"] > 0:
                b["v"] = -b["v"]
        if len(self.bugs) < 3 and random.random() < dt * 1.5 or len(self.bugs) < 6 and random.random() < dt * 0.25:
            self.novo_bug()
        if t >= self.prox_verbo:
            self.verbo, self.prox_verbo = random.choice(self.VERBOS), t + random.uniform(5, 9)
        self.acc_cod += dt
        if self.acc_cod > 1.4:
            self.acc_cod = 0.0
            self.codigo.pop(0)
            self.codigo.append(self.linha_codigo())
            self.destaque = {k - 1: v for k, v in self.destaque.items() if k > 0}
        ch[:] = self.vazio
        self.desenhar_codigo(t, ch, co)
        self.desenhar_hud(t, ch, co)
        self.desenhar_desfile(t, dt, ch, co)
        self.desenhar_bugs(t, ch, co)
        self.desenhar_clawd(t, ch, co)
        self.desenhar_particulas(t, dt, ch, co)
        self.desenhar_baloes(t, ch, co)
        escrever(ch, co, w, h, 0, self.chao + 1, "─" * w, 0x3A3A3A)

    def desenhar_codigo(self, t, ch, co):
        w, h = self.w, self.h
        for k, (txt, c) in enumerate(self.codigo):
            y = 4 + k
            if y >= self.chao - 10:
                break
            t0 = self.destaque.get(k)
            if t0 is not None and t - t0 < 1.2:
                escrever(ch, co, w, h, 2, y, "✓ " + txt, misturar(0x5CFF7A, c, (t - t0) / 1.2))
            else:
                escrever(ch, co, w, h, 4, y, txt, c)

    def desenhar_hud(self, t, ch, co):
        w, h = self.w, self.h
        escrever(ch, co, w, h, 2, 1, "✻", self.LARANJA)
        escrever(ch, co, w, h, 4, 1, "Claude Code", 0xE6E6E6)
        escrever(ch, co, w, h, 16, 1, "· caçando bugs", 0x7A7A7A)
        escrever(ch, co, w, h, 2, 2, f"bugs corrigidos: {self.corrigidos}", 0x9A9A9A)
        k = self.testes // 5
        cor_barra = 0x5CFF7A if self.testes >= 100 else self.LARANJA
        escrever(ch, co, w, h, 24, 2, "testes", 0x9A9A9A)
        escrever(ch, co, w, h, 31, 2, "█" * k, cor_barra)
        escrever(ch, co, w, h, 31 + k, 2, "░" * (20 - k), 0x3A3A3A)
        escrever(ch, co, w, h, 52, 2, f"{self.testes}% passando", 0x9A9A9A)
        verbo = (self.pensando[0] if self.pensando else self.verbo) + "…"
        resto = f" ({int(t)}s · ↓ {t * 0.35:.1f}k tokens · esc to interrupt)"
        x = max(0, w - 4 - len(verbo) - len(resto))
        escrever(ch, co, w, h, x - 2, 1, self.SPIN[int(t * 8) % len(self.SPIN)], self.LARANJA)
        for i, s in enumerate(verbo):
            escrever(ch, co, w, h, x + i, 1, s, misturar(self.LARANJA, 0xFFE0C8, max(0.0, math.sin(i * 0.45 - t * 5)) ** 6))
        escrever(ch, co, w, h, x + len(verbo), 1, resto, 0x6A6A6A)

    def desenhar_desfile(self, t, dt, ch, co):
        w, h = self.w, self.h
        if t >= self.prox_mini:
            v = random.uniform(5, 10) * random.choice((-1, 1))
            self.minis.append([-9.0 if v > 0 else float(w), v, random.random() * 2])
            self.prox_mini = t + random.uniform(4, 9)
        vivos = []
        for m in self.minis:
            m[0] += m[1] * dt
            if -10 < m[0] < w + 1:
                vivos.append(m)
                passo = int(t * 8 + m[2]) % 2
                for k, l in enumerate(MINI_CLAWD[:2] + [MINI_CLAWD[2] if passo else MINI_PASSO]):
                    escrever(ch, co, w, h, int(m[0]), self.chao - 2 + k, l, escala(self.LARANJA, 0.4))
        self.minis = vivos

    def desenhar_bugs(self, t, ch, co):
        w, h = self.w, self.h
        for b in self.bugs:
            passo = int(t * 7 + b["fase"]) % 2
            arte = BUG[:-1] + [BUG[-1] if passo else BUG_PASSO]
            alt = b["alt"] + (math.sin(t * 4 + b["fase"]) * 1.2 if b["voa"] else 0)
            y0 = 2 * (self.chao - int(alt)) + 2 - len(arte)
            if b.get("rola"):
                mini, _pw, ph = self.mini_rola
                blit(ch, co, w, h, {(int(b["x"]) + x, 2 * (self.chao - int(alt)) + 2 - ph + y): c for (x, y), c in mini.items()})
            else:
                blit(ch, co, w, h, arte_pixels(arte, int(b["x"]), y0, 1, {"#": b["cor"], "o": escala(b["cor"], 0.45)}))
            if b["voa"]:
                escrever(ch, co, w, h, int(b["x"]) + 1, y0 // 2 - 1, "^   ^" if passo else "v   v", 0xCFCFCF)

    def desenhar_clawd(self, t, ch, co):
        w, h, s = self.w, self.h, self.esc
        arte = list(CLAWD)
        olhar = self.dir if (self.andando or self.pulo_px) else 0
        olhos = list("...############...")
        if (t % 4.3) >= 0.14:
            olhos[5 + olhar] = "."
            olhos[12 + olhar] = "."
        arte[1] = "".join(olhos)
        if self.andando and int(t * 9) % 2:
            arte[4] = CLAWD_PASSO
        y0 = 2 * self.chao + 2 - 10 * s - int(self.pulo_px)
        blit(ch, co, w, h, arte_pixels(arte, int(self.x), y0, s, {"#": self.LARANJA}, ey=2 * s))

    def desenhar_particulas(self, t, dt, ch, co):
        w, h = self.w, self.h
        vivas = []
        for p in self.parts:
            p[3] += 25 * dt
            p[0] += p[2] * dt
            p[1] += p[3] * dt
            vida = (t - p[6]) / p[7]
            if vida < 1:
                vivas.append(p)
                escrever(ch, co, w, h, int(p[0]), int(p[1]), p[4], escala(p[5], 1 - vida * 0.7))
        self.parts = vivas
        vivos = []
        for f in self.flutua:
            vida = t - f[4]
            if vida < 1.2:
                vivos.append(f)
                escrever(ch, co, w, h, int(f[0]), int(f[1] - vida * 5), f[2], escala(f[3], 1 - vida * 0.6))
        self.flutua = vivos

    def caixa(self, ch, co, x1, y1, x2, y2, c):
        w, h = self.w, self.h
        escrever(ch, co, w, h, x1, y1, "╭" + "─" * (x2 - x1 - 1) + "╮", c, opaco=True)
        escrever(ch, co, w, h, x1, y2, "╰" + "─" * (x2 - x1 - 1) + "╯", c, opaco=True)
        for y in range(y1 + 1, y2):
            escrever(ch, co, w, h, x1, y, "│" + " " * (x2 - x1 - 1) + "│", c, opaco=True)

    def desenhar_baloes(self, t, ch, co):
        w, h = self.w, self.h
        topo = self.chao + 1 - 5 * self.esc - int(self.pulo_px) // 2
        meio = int(self.x + self.cw / 2)
        if self.pensando:
            verbo, t0 = self.pensando
            txt = f"{self.SPIN[int(t * 8) % len(self.SPIN)]} {verbo}…"
            x1 = max(0, min(w - len(txt) - 5, meio - len(txt) // 2 - 2))
            self.caixa(ch, co, x1, topo - 6, x1 + len(txt) + 3, topo - 4, 0x8A8A8A)
            escrever(ch, co, w, h, x1 + 2, topo - 5, txt[0], self.LARANJA)
            for i, s in enumerate(txt[1:]):
                escrever(ch, co, w, h, x1 + 3 + i, topo - 5, s,
                         misturar(self.LARANJA, 0xFFE0C8, max(0.0, math.sin(i * 0.45 - t * 5)) ** 6))
            escrever(ch, co, w, h, meio, topo - 3, "o", 0x8A8A8A)
            escrever(ch, co, w, h, meio + 1, topo - 2, "°", 0x8A8A8A)
        elif self.fala and t - self.fala_t < 3.2:
            n = min(len(self.fala), int((t - self.fala_t) * 30))
            txt = self.fala
            x1 = max(0, min(w - len(txt) - 5, meio - len(txt) // 2 - 2))
            self.caixa(ch, co, x1, topo - 5, x1 + len(txt) + 3, topo - 3, 0x8A8A8A)
            c = self.LARANJA if txt.startswith("Você tem") else 0xE6E6E6
            escrever(ch, co, w, h, x1 + 2, topo - 4, txt[:n], c)
            escrever(ch, co, w, h, meio, topo - 2, "╲" if meio > x1 + 2 else "╱", 0x8A8A8A)


CORES_CLAWD = {"#": 0xD97757, "e": 0x6B3426}


def arte_clawd(olhar=0, fechados=False, passo=False, agachado=False):
    arte = list(CLAWD)
    olhos = list("...############...")
    olhos[5 + olhar] = olhos[12 + olhar] = "e" if fechados else "."
    arte[1] = "".join(olhos)
    if passo:
        arte[4] = CLAWD_PASSO
    return arte[:4] if agachado else arte


def balao(ch, co, w, h, meio, base, txt, n=None, c=0xE6E6E6, borda=0x8A8A8A):
    """Balão de fala com a ponta apontando pra (meio, base)."""
    x1 = max(0, min(w - len(txt) - 5, meio - len(txt) // 2 - 2))
    x2 = x1 + len(txt) + 3
    y1 = base - 3
    visivel = txt if n is None else txt[:n]
    escrever(ch, co, w, h, x1, y1, "╭" + "─" * (x2 - x1 - 1) + "╮", borda, opaco=True)
    escrever(ch, co, w, h, x1, y1 + 1, "│" + " " * (x2 - x1 - 1) + "│", borda, opaco=True)
    escrever(ch, co, w, h, x1 + 2, y1 + 1, visivel, c)
    escrever(ch, co, w, h, x1, y1 + 2, "╰" + "─" * (x2 - x1 - 1) + "╯", borda, opaco=True)
    escrever(ch, co, w, h, max(x1 + 1, min(x2 - 1, meio)), y1 + 3, "╲" if meio > x1 + 2 else "╱", borda)


class ClawdSoneca(Cena):
    """Clawd tirando uma soneca debaixo das estrelas."""
    combinavel = False
    peso = 0.7
    duracao = (35, 50)
    FALAS = ["hm?", "✻ so pretty…", "…just 5 more minutes…", "zzz… refactor… zzz", "dreamt about a bug",
             "I'm up, I'm up", "was that a meteor or a deploy?", "dreamt Spurs won the league… nightmare."]

    def iniciar(self):
        w, h = self.w, self.h
        self.esc = 3 if w >= 120 and h >= 45 else 2 if h >= 24 else 1
        self.cw = 18 * self.esc
        self.chao = h - 4
        self.x = max(0, min(w - self.cw, (w - self.cw) // 2 + random.randint(-w // 6, w // 6)))
        self.t = 0.0
        self.estrelas = [(random.randrange(w), random.randrange(max(1, h - 10)), random.random(), random.uniform(0, 6.3))
                         for _ in range(w * h // 55)]
        r = random.uniform(4, 6.5)
        self.lua = (random.choice((w * 0.15, w * 0.82)) + random.uniform(-5, 5), random.uniform(8, h * 0.45), r,
                    random.uniform(0.35, 0.9) * random.choice((-1, 1)))
        self.zs, self.prox_z = [], 0.5
        self.cadente, self.prox_cadente = None, random.uniform(5, 10)
        self.acordado, self.olhar = -1.0, 0
        self.fala, self.fala_t = "", -10.0
        self.vaga = [[random.uniform(0, w), random.uniform(h - 14, h - 5), random.uniform(0, 6.3)]
                     for _ in range(random.randint(5, 10))]
        self.grama = [(x, random.choice(",.'\"`")) for x in range(w) if random.random() < 0.35]

    def draw(self, t, dt, ch, co):
        self.t = t
        w, h, s = self.w, self.h, self.esc
        ch[:] = self.vazio
        for x, y, b, f in self.estrelas:
            v = b * (0.55 + 0.45 * math.sin(t * 1.7 + f))
            escrever(ch, co, w, h, x, y, "*" if b > 0.93 else "·" if b > 0.6 else ".", escala(0xC8D2FF, 0.2 + 0.7 * v))
        lx, ly, r, fase = self.lua
        lua = {}
        for py in range(int(ly - r) - 1, int(ly + r) + 2):
            for x in range(int(lx - r) - 1, int(lx + r) + 2):
                dx, dy = x + 0.5 - lx, py + 0.5 - ly
                if dx * dx + dy * dy <= r * r:
                    sombra = (dx - fase * r * 1.1) ** 2 + dy * dy <= (r * 0.95) ** 2
                    lua[(x, py)] = 0x1A1A24 if sombra else 0xF5E6A8
        blit(ch, co, w, h, lua)
        if self.cadente is None and t >= self.prox_cadente:
            vx = random.uniform(50, 80) * random.choice((-1, 1))
            self.cadente = [random.uniform(w * 0.2, w * 0.8), random.uniform(1, h * 0.3), vx, random.uniform(8, 16), t]
            self.acordado = t + 3.2
            self.olhar = 1 if vx > 0 else -1
            self.prox_cadente = t + random.uniform(8, 16)
        if self.cadente:
            x0, y0, vx, vy, t0 = self.cadente
            idade = t - t0
            for k in range(10):
                a = max(0.0, idade - k * 0.012)
                escrever(ch, co, w, h, int(x0 + vx * a), int(y0 + vy * a), "*" if k == 0 else "·",
                         escala(0xFFFFFF, 1 - k / 10))
            if idade > 1.4:
                self.cadente = None
                if random.random() < 0.6:
                    self.fala, self.fala_t = random.choice(self.FALAS), t
        for x in range(w):
            escrever(ch, co, w, h, x, self.chao + 1, "▀", fundo(0x1F4F2A, 0x0B1A0F))
            for y in range(self.chao + 2, h):
                escrever(ch, co, w, h, x, y, "█", 0x0B1A0F)
        for x, g in self.grama:
            escrever(ch, co, w, h, x, self.chao, g, 0x2F6F3A)
        for v in self.vaga:
            v[0] += random.gauss(0, 0.3)
            v[1] = min(h - 4.0, max(h - 16.0, v[1] + random.gauss(0, 0.1)))
            b = (math.sin(t * 2 + v[2]) + 1) / 2
            if b > 0.3:
                escrever(ch, co, w, h, int(v[0]), int(v[1]), "•", escala(0xD8FF6A, b))
        dormindo = t > self.acordado
        bob = 1 if math.sin(t * 1.6) > 0.3 else 0
        y0 = 2 * self.chao + 2 - 10 * s - bob
        arte = arte_clawd(olhar=0 if dormindo else self.olhar, fechados=dormindo)
        blit(ch, co, w, h, arte_pixels(arte, self.x, y0, s, CORES_CLAWD, ey=2 * s))
        cabeca = y0 // 2
        if dormindo and t >= self.prox_z:
            self.zs.append([self.x + self.cw * 0.8, cabeca, t])
            self.prox_z = t + random.uniform(1.0, 1.6)
        vivos = []
        for z in self.zs:
            idade = t - z[2]
            if idade < 3.5:
                vivos.append(z)
                escrever(ch, co, w, h, int(z[0] + idade * 2.5), int(z[1] - idade * 1.6), "z" if idade < 1.2 else "Z",
                         escala(0xC8D8FF, 1 - idade / 3.5))
        self.zs = vivos
        if self.fala and t - self.fala_t < 3.0:
            balao(ch, co, w, h, int(self.x + self.cw * 0.5), cabeca - 1, self.fala, int((t - self.fala_t) * 30))


class ClawdFesta(Cena):
    """Festa dos Clawds: coreografia sincronizada, luzes de boate e pista colorida."""
    combinavel = False
    peso = 0.7
    duracao = (30, 45)
    PASSOS = ["pulo", "onda", "balanco", "agacha", "olhar", "alternado"]
    TITULOS = ["CLAWD PARTY", "CLAWD DISCO", "NIGHT FEVER", "DEPLOY PARTY", "COYG"]

    def iniciar(self):
        w, h = self.w, self.h
        self.batida = 60 / random.choice((108, 120, 128))
        self.esc = 2 if w >= 90 and h >= 34 else 1
        cw = 18 * self.esc
        n = max(1, min(4, (w + 2) // (cw + 4)))
        gap = (w - n * cw) / (n + 1)
        self.frente = [int(gap + k * (cw + gap)) for k in range(n)]
        nt = max(1, (w - 4) // 24)
        gapt = (w - nt * 18) / (nt + 1)
        self.atras = [int(gapt + k * (18 + gapt)) for k in range(nt)]
        self.chao = h - 7
        self.passo = random.choice(self.PASSOS)
        self.prox_troca = 8
        self.hue = random.random()
        self.notas, self.confete = [], []
        self.ult_batida = -1
        self.titulo = meio_blocos(texto_grade(random.choice(self.TITULOS)))
        self.focos = [(random.uniform(0.1, 0.9), random.uniform(0, 6.3), random.random())
                      for _ in range(random.randint(3, 5))]

    def pose(self, i, b, alt):
        frac = b % 1
        dx, dy, olhar, agacha, passo = 0, 0.0, 0, False, False
        p = self.passo
        if p == "pulo":
            dy = math.sin(frac * math.pi) * alt
        elif p == "onda":
            dy = max(0.0, math.sin((b * 0.5 - i * 0.18) * 2 * math.pi)) * alt
        elif p == "balanco":
            dx = round(math.sin(b * math.pi) * 3)
            passo = int(b) % 2 == 0
        elif p == "agacha":
            agacha = frac < 0.5
            dy = 0.0 if agacha else math.sin((frac - 0.5) * 2 * math.pi) * alt * 0.5
        elif p == "olhar":
            olhar = 1 if int(b) % 2 else -1
            dy = math.sin(frac * math.pi) * alt * 0.3
        elif (int(b) + i) % 2 == 0:
            dy = math.sin(frac * math.pi) * alt
        return dx, max(0.0, dy), olhar, agacha, passo

    def draw(self, t, dt, ch, co):
        w, h = self.w, self.h
        b = t / self.batida
        nb, frac = int(b), b % 1
        if nb >= self.prox_troca:
            self.passo = random.choice([p for p in self.PASSOS if p != self.passo])
            self.prox_troca = nb + 8
            for _ in range(70):
                self.confete.append([random.uniform(0, w), -1.0, random.uniform(-4, 4), random.uniform(6, 14),
                                     random.choice("✻*+·•"), hsv(random.random(), 0.7, 1.0), t])
        if nb != self.ult_batida:
            self.ult_batida = nb
            for _ in range(random.randint(1, 2)):
                self.notas.append([random.uniform(2, w - 2), float(self.chao - 12), random.choice("♪♫"),
                                   hsv(random.random(), 0.6, 1.0), t])
        ch[:] = self.vazio
        for x0, fase, hue in self.focos:
            ang = math.sin(t * 0.8 + fase) * 0.55
            c = escala(hsv(hue + t * 0.05, 0.7, 1.0), 0.22)
            for y in range(self.chao + 1):
                cx = x0 * w + math.tan(ang) * y * ASPECTO
                meia = 1 + y * 0.35
                for x in range(int(cx - meia), int(cx + meia) + 1):
                    if 0 <= x < w:
                        ch[y * w + x], co[y * w + x] = "░", c
        tw = len(self.titulo[0])
        for r, linha in enumerate(self.titulo):
            for k, s in enumerate(linha):
                if s != " ":
                    escrever(ch, co, w, h, (w - tw) // 2 + k, 1 + r, s,
                             hsv(self.hue + k / tw + nb * 0.1, 0.7, 0.7 + 0.3 * (1 - frac)))
        pisca = (t % 3.7) < 0.12
        pes_atras = self.chao - 5 * self.esc - 3
        for i, x in enumerate(self.atras):
            dy = max(0.0, math.sin((b * 0.5 - i * 0.12) * 2 * math.pi)) * 2
            arte = arte_clawd(fechados=pisca)
            cores = {k: escala(v, 0.55) for k, v in CORES_CLAWD.items()}
            blit(ch, co, w, h, arte_pixels(arte, x, 2 * pes_atras + 2 - 10 - int(dy), 1, cores, ey=2))
        escrever(ch, co, w, h, 0, pes_atras + 1, "▁" * w, 0x3A2A4A)
        s = self.esc
        for i, x in enumerate(self.frente):
            dx, dy, olhar, agacha, passo = self.pose(i, b, 6)
            arte = arte_clawd(olhar=olhar, fechados=pisca, passo=passo, agachado=agacha)
            y0 = 2 * self.chao + 2 - len(arte) * 2 * s - int(dy)
            blit(ch, co, w, h, arte_pixels(arte, x + dx, y0, s, CORES_CLAWD, ey=2 * s))
        for y in range(self.chao + 1, h):
            for x in range(w):
                tx, ty = x // 8, (y - self.chao - 1) // 2
                aceso = (tx + ty + nb) % 2 == 0
                c = hsv(self.hue + (tx + ty * 3 + nb) * 0.13, 0.7, (0.3 + 0.5 * (1 - frac)) if aceso else 0.18)
                if x % 8 == 7:
                    continue
                ch[y * w + x], co[y * w + x] = ("▀" if (y - self.chao - 1) % 2 else "█"), c
        vivas = []
        for n_ in self.notas:
            idade = t - n_[4]
            if idade < 2.5:
                vivas.append(n_)
                escrever(ch, co, w, h, int(n_[0] + math.sin(idade * 4) * 2), int(n_[1] - idade * 3), n_[2],
                         escala(n_[3], 1 - idade / 2.5))
        self.notas = vivas
        vivos = []
        for c_ in self.confete:
            c_[0] += c_[2] * dt
            c_[1] += c_[3] * dt
            if c_[1] < h and t - c_[6] < 5:
                vivos.append(c_)
                escrever(ch, co, w, h, int(c_[0]), int(c_[1]), c_[4], c_[5])
        self.confete = vivos


class ClawdEspaco(Cena):
    """Clawd de jetpack voando pelo espaço, desviando de asteroides."""
    combinavel = False
    peso = 0.7
    duracao = (30, 45)
    FALAS = ["Houston, we have a bug.", "Off to deploy!", "✻ Pondering the cosmos…", "To infinity and beyond the rate limit!",
             "Is that a black hole or a memory leak?", "Wow.", "Faster than a git push --force!",
             "Even from up here, North London is red."]

    def iniciar(self):
        w, h = self.w, self.h
        self.esc = 2 if w >= 90 and h >= 30 else 1
        self.cw, self.alt = 18 * self.esc, 10 * self.esc
        self.x = int(w * 0.2)
        self.y = float(h)
        self.t = 0.0
        self.estrelas = [[random.uniform(0, w), random.randrange(h), random.choice((1, 1, 2, 3))] for _ in range(w * h // 45)]
        self.planetas = [self.novo_planeta(random.uniform(w * 0.45, w * 0.9))]
        self.prox_planeta = random.uniform(10, 18)
        self.asteroides, self.fogo, self.brilhos, self.itens = [], [], [], []
        self.prox_ast = random.uniform(1.5, 3)
        self.prox_item = random.uniform(3, 6)
        self.fala, self.fala_t = "", -10.0
        self.prox_fala = random.uniform(6, 12)

    def novo_planeta(self, x=None):
        r = random.uniform(6, 13)
        return {"x": self.w + r * 2 + 2 if x is None else x, "y": random.uniform(r, 2 * self.h - r), "r": r,
                "cor": hsv(random.random(), random.uniform(0.35, 0.7), 0.9), "anel": random.random() < 0.45,
                "vel": random.uniform(1.5, 4), "faixa": random.random() < 0.5}

    def planeta_pixels(self, p, px):
        r, x0, y0 = p["r"], p["x"], p["y"]
        anel = escala(p["cor"], 0.75)
        a, bb = r * 1.9, r * 0.42
        for py in range(int(y0 - r) - 1, int(y0 + r) + 2):
            for x in range(int(x0 - a) - 1, int(x0 + a) + 2):
                dx, dy = x + 0.5 - x0, py + 0.5 - y0
                d2 = dx * dx + dy * dy
                e = (dx / a) ** 2 + (dy / bb) ** 2
                no_anel = p["anel"] and 0.78 < e < 1.12
                if d2 <= r * r:
                    if no_anel and dy > 0:
                        px[(x, py)] = anel
                        continue
                    nz = math.sqrt(1 - d2 / (r * r))
                    luz = clamp((-dx * 0.6 - dy * 0.5) / r * 0.8 + nz * 0.6)
                    c = escala(p["cor"], 0.1 + 0.9 * luz)
                    if p["faixa"] and int((dy / r + 1) * 4) % 2:
                        c = escala(c, 0.8)
                    px[(x, py)] = c
                elif no_anel:
                    px[(x, py)] = anel

    def draw(self, t, dt, ch, co):
        self.t = t
        w, h, s = self.w, self.h, self.esc
        ch[:] = self.vazio
        for e in self.estrelas:
            e[0] -= e[2] * 6 * dt
            if e[0] < 0:
                e[0] += w
                e[1] = random.randrange(h)
            escrever(ch, co, w, h, int(e[0]), e[1], ".·*"[e[2] - 1], (0x505060, 0x9090A0, 0xE0E0F0)[e[2] - 1])
        if t >= self.prox_planeta:
            self.planetas.append(self.novo_planeta())
            self.prox_planeta = t + random.uniform(12, 20)
        if t >= self.prox_ast:
            r = random.uniform(2, 5)
            self.asteroides.append({"x": w + r + 1, "y": random.uniform(r, 2 * h - r), "r": r,
                                    "vel": random.uniform(15, 30), "sem": random.uniform(0, 6.3), "rot": random.uniform(-2, 2)})
            self.prox_ast = t + random.uniform(0.8, 2.2)
        if t >= self.prox_item:
            self.itens.append([float(w), random.uniform(6, 2 * h - 6)])
            self.prox_item = t + random.uniform(3, 7)
        px = {}
        for p in self.planetas:
            p["x"] -= p["vel"] * dt
        self.planetas = [p for p in self.planetas if p["x"] + p["r"] * 2 > 0]
        for p in self.planetas:
            self.planeta_pixels(p, px)
        cy = self.y + math.sin(t * 3) * 1.5
        topo, base = cy - self.alt / 2, cy + self.alt / 2
        vivos = []
        for a in self.asteroides:
            a["x"] -= a["vel"] * dt
            if a["x"] + a["r"] < 0:
                continue
            if self.x - a["r"] < a["x"] < self.x + self.cw + a["r"] and topo - a["r"] < a["y"] < base + a["r"]:
                for _ in range(16):
                    ang = random.uniform(0, 6.3)
                    self.brilhos.append([a["x"], a["y"] / 2, math.cos(ang) * 12, math.sin(ang) * 6, "·", 0x9A9088, t])
                self.fala, self.fala_t = "Ouch!", t
                continue
            vivos.append(a)
            r = a["r"]
            for py in range(int(a["y"] - r) - 1, int(a["y"] + r) + 2):
                for x in range(int(a["x"] - r) - 1, int(a["x"] + r) + 2):
                    dx, dy = x + 0.5 - a["x"], py + 0.5 - a["y"]
                    th = math.atan2(dy, dx) + t * a["rot"]
                    rr = r * (0.75 + 0.25 * math.sin(3 * th + a["sem"]) * math.sin(5 * th + 2 * a["sem"]))
                    if dx * dx + dy * dy <= rr * rr:
                        px[(x, py)] = escala(0x8A8078, 0.35 + 0.65 * clamp(0.5 - (dx + dy) / (2 * r)))
        self.asteroides = vivos
        ameacas = [a for a in self.asteroides if self.x - 5 < a["x"] < self.x + self.cw + 45
                   and abs(a["y"] - self.y) < a["r"] + self.alt / 2 + 3]
        if ameacas:
            a = min(ameacas, key=lambda a: a["x"])
            alvo = a["y"] + (self.alt / 2 + a["r"] + 6) * (1 if self.y >= a["y"] else -1)
        elif self.itens:
            alvo = self.itens[0][1]
        else:
            alvo = h + math.sin(t * 0.5) * h * 0.45
        alvo = max(self.alt / 2 + 2, min(2 * h - self.alt / 2 - 2, alvo))
        self.y += (alvo - self.y) * min(1.0, dt * 3)
        blit(ch, co, w, h, px)
        for _ in range(6):
            self.fogo.append([self.x - self.esc + 0.0, cy / 2 + random.uniform(-1.2, 1.2), -random.uniform(25, 45),
                              random.uniform(-2.5, 2.5), t, random.uniform(0.3, 0.55)])
        vivos = []
        for f in self.fogo:
            idade = (t - f[4]) / f[5]
            if idade < 1:
                vivos.append(f)
                f[0] += f[2] * dt
                f[1] += f[3] * dt
                escrever(ch, co, w, h, int(f[0]), int(f[1]), "█▓▒░"[min(3, int(idade * 4))],
                         escala(misturar(0xFFF6C8, 0xFF5A1F, idade * 1.6), 1 - idade * 0.45))
        self.fogo = vivos
        vivos = []
        for it in self.itens:
            it[0] -= 12 * dt
            if it[0] < 0:
                continue
            if self.x <= it[0] <= self.x + self.cw and topo - 2 <= it[1] <= base + 2:
                for _ in range(14):
                    ang = random.uniform(0, 6.3)
                    self.brilhos.append([it[0], it[1] / 2, math.cos(ang) * 14, math.sin(ang) * 7, "✻",
                                         0xD97757, t])
                continue
            vivos.append(it)
            escrever(ch, co, w, h, int(it[0]), int(it[1] / 2), "✻", 0xFFB38A if int(t * 4) % 2 else 0xD97757)
        self.itens = vivos
        corpo = arte_pixels(arte_clawd(olhar=1, fechados=(t % 4.1) < 0.13), self.x, int(topo), s, CORES_CLAWD, ey=2 * s)
        for yy in range(int(topo) + 2 * s, int(topo) + 8 * s):
            for xx in range(self.x - s, self.x + s):
                corpo.setdefault((xx, yy), 0x9A9AA6)
        blit(ch, co, w, h, corpo)
        vivos = []
        for b in self.brilhos:
            if t - b[6] < 0.8:
                vivos.append(b)
                b[0] += b[2] * dt
                b[1] += b[3] * dt
                escrever(ch, co, w, h, int(b[0]), int(b[1]), b[4], escala(b[5], 1 - (t - b[6]) / 0.8))
        self.brilhos = vivos
        if t >= self.prox_fala:
            self.fala, self.fala_t = random.choice(self.FALAS), t
            self.prox_fala = t + random.uniform(8, 14)
        if self.fala and t - self.fala_t < 3.0:
            balao(ch, co, w, h, int(self.x + self.cw * 0.6), int(topo) // 2 - 1, self.fala, int((t - self.fala_t) * 30))


class Tetris(Cena):
    """Tetris jogando sozinho (uma IA simples escolhe cada jogada)."""
    combinavel = False
    duracao = (45, 60)
    FORMAS = {"I": [(0, 0), (1, 0), (2, 0), (3, 0)], "O": [(0, 0), (1, 0), (0, 1), (1, 1)],
              "T": [(0, 0), (1, 0), (2, 0), (1, 1)], "S": [(1, 0), (2, 0), (0, 1), (1, 1)],
              "Z": [(0, 0), (1, 0), (1, 1), (2, 1)], "J": [(0, 0), (0, 1), (1, 1), (2, 1)],
              "L": [(2, 0), (0, 1), (1, 1), (2, 1)]}
    CORES = {"I": 0x00E5FF, "O": 0xFFE100, "T": 0xB04DFF, "S": 0x35E05A, "Z": 0xFF3B4E, "J": 0x3D7BFF, "L": 0xFF9A1F}
    COLS, LINS = 10, 20

    def iniciar(self):
        self.bw, self.bh = (4, 2) if self.h >= 44 else (2, 1)
        self.rots = {k: self.rotacoes(v) for k, v in self.FORMAS.items()}
        self.t = 0.0
        self.novo_jogo()

    def rotacoes(self, cel):
        out, atual = [], cel
        for _ in range(4):
            mx, my = min(x for x, y in atual), min(y for x, y in atual)
            norm = sorted((x - mx, y - my) for x, y in atual)
            if norm not in out:
                out.append(norm)
            atual = [(-y, x) for x, y in atual]
        return out

    def novo_jogo(self):
        C, L = self.COLS, self.LINS
        self.g = [[None] * C for _ in range(L)]
        for y in range(L - random.randint(5, 9), L):
            buraco = random.randrange(C)
            self.g[y] = [None if x == buraco or random.random() < 0.12 else random.choice("IOTSZJL") for x in range(C)]
        self.fila = []
        self.pontos, self.feitas, self.nivel = 0, 0, 1
        self.stats = {k: 0 for k in self.FORMAS}
        self.limpando = set()
        self.nova_peca()

    def nova_peca(self):
        while len(self.fila) < 2:
            bolsa = list(self.FORMAS)
            random.shuffle(bolsa)
            self.fila += bolsa
        self.p = self.fila.pop(0)
        self.stats[self.p] += 1
        self.pr, self.px, self.py = 0, 3, 0
        self.acc = 0.0
        if not self.cabe(self.p, 0, 3, 0):
            self.estado, self.t_est = "fim", self.t
            return
        self.alvo = self.melhor()
        self.estado = "mover"

    def cabe(self, p, r, x, y):
        for cx, cy in self.rots[p][r]:
            X, Y = x + cx, y + cy
            if X < 0 or X >= self.COLS or Y >= self.LINS or (Y >= 0 and self.g[Y][X]):
                return False
        return True

    def melhor(self):
        melhor, alvo = -1e9, (0, 3)
        for r in range(len(self.rots[self.p])):
            for x in range(-3, self.COLS):
                if not self.cabe(self.p, r, x, 0):
                    continue
                y = 0
                while self.cabe(self.p, r, x, y + 1):
                    y += 1
                nota = self.avaliar(self.p, r, x, y) + random.uniform(0, 0.08)
                if nota > melhor:
                    melhor, alvo = nota, (r, x)
        return alvo

    def avaliar(self, p, r, x, y):
        C, L = self.COLS, self.LINS
        g = [linha[:] for linha in self.g]
        for cx, cy in self.rots[p][r]:
            if y + cy >= 0:
                g[y + cy][x + cx] = p
        cheias = sum(1 for l in g if all(l))
        g = [[None] * C for _ in range(cheias)] + [l for l in g if not all(l)]
        alturas, buracos = [], 0
        for cx in range(C):
            alt, bloco = 0, False
            for cy in range(L):
                if g[cy][cx]:
                    if not bloco:
                        alt, bloco = L - cy, True
                elif bloco:
                    buracos += 1
            alturas.append(alt)
        bump = sum(abs(alturas[i] - alturas[i + 1]) for i in range(C - 1))
        return -0.51 * sum(alturas) + 0.76 * cheias - 0.36 * buracos - 0.18 * bump

    def travar(self):
        for cx, cy in self.rots[self.p][self.pr]:
            if self.py + cy >= 0:
                self.g[self.py + cy][self.px + cx] = self.p
        cheias = [i for i, l in enumerate(self.g) if all(l)]
        if cheias:
            self.limpando = set(cheias)
            self.estado, self.t_est = "limpar", self.t
            self.feitas += len(cheias)
            self.pontos += (0, 100, 300, 500, 800)[len(cheias)] * self.nivel
            self.nivel = 1 + self.feitas // 10
        else:
            self.pontos += 4
            self.nova_peca()

    def atualizar(self, t, dt):
        if self.estado == "mover":
            self.acc += dt
            while self.acc >= 0.055 and self.estado == "mover":
                self.acc -= 0.055
                ra, xa = self.alvo
                n = len(self.rots[self.p])
                if self.pr != ra:
                    nr = (self.pr + 1) % n
                    if self.cabe(self.p, nr, self.px, self.py):
                        self.pr = nr
                    else:
                        self.alvo = (self.pr, xa)
                elif self.px != xa:
                    nx = self.px + (1 if xa > self.px else -1)
                    if self.cabe(self.p, self.pr, nx, self.py):
                        self.px = nx
                    else:
                        self.alvo = (ra, self.px)
                else:
                    self.estado, self.acc = "cair", 0.0
        elif self.estado == "cair":
            self.acc += dt * 30
            while self.acc >= 1 and self.estado == "cair":
                self.acc -= 1
                if self.cabe(self.p, self.pr, self.px, self.py + 1):
                    self.py += 1
                else:
                    self.travar()
        elif self.estado == "limpar":
            if t - self.t_est > 0.4:
                resto = [l for i, l in enumerate(self.g) if i not in self.limpando]
                self.g = [[None] * self.COLS for _ in self.limpando] + resto
                self.limpando = set()
                self.nova_peca()
        elif self.estado == "fim" and t - self.t_est > 1.6:
            self.novo_jogo()

    def bloco(self, ch, co, x, y, c, fantasma=False):
        w, h = self.w, self.h
        if fantasma:
            c = escala(c, 0.4)
            if self.bw == 4:
                escrever(ch, co, w, h, x, y, "┌──┐", c)
                escrever(ch, co, w, h, x, y + 1, "└──┘", c)
            else:
                escrever(ch, co, w, h, x, y, "░░", c)
        elif self.bw == 4:
            escrever(ch, co, w, h, x, y, "▐██▌", misturar(c, 0xFFFFFF, 0.35))
            escrever(ch, co, w, h, x, y + 1, "▐██▌", c)
        else:
            escrever(ch, co, w, h, x, y, "▐▌", c)

    def draw(self, t, dt, ch, co):
        self.t = t
        self.atualizar(t, dt)
        ch[:] = self.vazio
        w, h, bw, bh, C, L = self.w, self.h, self.bw, self.bh, self.COLS, self.LINS
        ox, oy = w // 2 - C * bw // 2, max(1, (h - L * bh) // 2)
        borda = 0x4A4A5A
        escrever(ch, co, w, h, ox - 1, oy - 1, "┌" + "─" * (C * bw) + "┐", borda)
        escrever(ch, co, w, h, ox - 1, oy + L * bh, "└" + "─" * (C * bw) + "┘", borda)
        for y in range(oy, oy + L * bh):
            escrever(ch, co, w, h, ox - 1, y, "│", borda)
            escrever(ch, co, w, h, ox + C * bw, y, "│", borda)
        pisca = int((t - getattr(self, "t_est", 0)) * 20) % 2 == 0
        fim = self.estado == "fim"
        cheias_fim = int((t - self.t_est) * 16) if fim else 0
        for r in range(L):
            for c in range(C):
                x, y = ox + c * bw, oy + r * bh
                p = self.g[r][c]
                if fim and L - 1 - r < cheias_fim:
                    self.bloco(ch, co, x, y, 0x5A5A66)
                elif p:
                    cor_ = 0xFFFFFF if (r in self.limpando and pisca) else self.CORES[p]
                    self.bloco(ch, co, x, y, cor_)
                else:
                    escrever(ch, co, w, h, x + bw // 2, y, "·", 0x24242E)
        if self.estado in ("mover", "cair"):
            gy = self.py
            while self.cabe(self.p, self.pr, self.px, gy + 1):
                gy += 1
            c_ = self.CORES[self.p]
            for cx, cy in self.rots[self.p][self.pr]:
                if gy + cy >= 0 and gy != self.py:
                    self.bloco(ch, co, ox + (self.px + cx) * bw, oy + (gy + cy) * bh, c_, fantasma=True)
            for cx, cy in self.rots[self.p][self.pr]:
                if self.py + cy >= 0:
                    self.bloco(ch, co, ox + (self.px + cx) * bw, oy + (self.py + cy) * bh, c_)
        branco, cinza = 0xE0E0E0, 0x8A8A8A
        xr = ox + C * bw + 4
        escrever(ch, co, w, h, xr, oy + 1, "NEXT", cinza)
        prox = self.fila[0]
        for cx, cy in self.rots[prox][0]:
            self.bloco(ch, co, xr + cx * bw, oy + 3 + cy * bh, self.CORES[prox])
        ys = oy + 4 + 2 * bh + 2
        for k, (rot, val) in enumerate((("SCORE", f"{self.pontos:06d}"), ("LINES", f"{self.feitas:03d}"),
                                         ("LEVEL", f"{self.nivel:02d}"))):
            escrever(ch, co, w, h, xr, ys + k * 4, rot, cinza)
            escrever(ch, co, w, h, xr, ys + k * 4 + 1, val, branco)
        if int(t * 1.5) % 2 == 0:
            escrever(ch, co, w, h, xr, ys + 13, "DEMO · IA JOGANDO", 0xFF9A1F)
        xl = ox - 30
        if xl >= 1:
            escrever(ch, co, w, h, xl, oy + 1, "STATISTICS", cinza)
            for k, p in enumerate("TJZOSLI"):
                y = oy + 3 + k * 3
                for cx, cy in self.rots[p][0]:
                    escrever(ch, co, w, h, xl + cx * 2, y + cy, "██", self.CORES[p])
                escrever(ch, co, w, h, xl + 12, y, f"{self.stats[p]:03d}", self.CORES[p])


class DVD(Cena):
    """O logo do DVD quicando. Uma hora ele acerta o canto."""
    combinavel = False
    duracao = (32, 42)

    def iniciar(self):
        g = texto_grade("DVD", 2)
        lw = len(g[0])
        disco = [[((px + 0.5 - lw / 2) / (lw / 2)) ** 2 + ((py + 0.5 - 2.5) / 2.5) ** 2 <= 1 for px in range(lw)]
                 for py in range(5)]
        self.logo = meio_blocos(g + [[False] * lw] + disco)
        self.lw, self.lh = lw, len(self.logo)
        self.rola = None
        if OVOS or random.random() < 0.25:
            self.rola, pw, ph = rola_pixels(0.36)
            self.lw, self.lh = pw, (ph + 1) // 2
        self.maxx, self.maxy = max(1, self.w - self.lw), max(1, self.h - self.lh)
        tc = random.uniform(7, 15)
        x, y = float(random.choice((0, self.maxx))), float(random.choice((0, self.maxy)))
        vx, vy = (13.0 if x == 0 else -13.0), (6.5 if y == 0 else -6.5)
        for _ in range(int(tc * 60)):
            x, vx, _b = self.mover(x, vx, self.maxx, 1 / 60)
            y, vy, _b = self.mover(y, vy, self.maxy, 1 / 60)
        self.x, self.y, self.vx, self.vy = x, y, -vx, -vy
        self.cor = self.cor_nova()
        self.ult = [-10.0, -10.0]
        self.festa = None
        self.confete = []
        self.cantos = 0
        self.grito = meio_blocos(texto_grade("ACERTOU O CANTO!"))

    @staticmethod
    def mover(x, v, maximo, dt):
        x += v * dt
        if x < 0:
            return -x, -v, True
        if x > maximo:
            return 2 * maximo - x, -v, True
        return x, v, False

    def cor_nova(self):
        return hsv(random.random(), 0.8, 1.0)

    def draw(self, t, dt, ch, co):
        w, h = self.w, self.h
        self.x, self.vx, bx = self.mover(self.x, self.vx, self.maxx, dt)
        self.y, self.vy, by = self.mover(self.y, self.vy, self.maxy, dt)
        if bx:
            self.ult[0] = t
        if by:
            self.ult[1] = t
        if bx or by:
            self.cor = self.cor_nova()
            if abs(self.ult[0] - self.ult[1]) < 0.12 and (self.festa is None or t - self.festa > 2):
                self.festejar(t)
        ch[:] = self.vazio
        vivos = []
        for c in self.confete:
            c[3] += 18 * dt
            c[0] += c[2] * dt
            c[1] += c[3] * dt
            c[2] *= 0.99
            if t - c[6] < c[7] and 0 <= c[0] < w and c[1] < h:
                vivos.append(c)
                escrever(ch, co, w, h, int(c[0]), int(c[1]), c[4], c[5])
        self.confete = vivos
        xi, yi = int(self.x), int(self.y)
        if self.rola:
            blit(ch, co, w, h, {(xi + x, 2 * yi + y): misturar(c, self.cor, 0.45) for (x, y), c in self.rola.items()})
        else:
            for r, linha in enumerate(self.logo):
                escrever(ch, co, w, h, xi, yi + r, linha, self.cor)
            yv, xv = yi + self.lh - 2, xi + (self.lw - 9) // 2
            for k, s in enumerate("V I D E O"):
                if s != " " and 0 <= xv + k < w and 0 <= yv < h:
                    ch[yv * w + xv + k] = s
                    co[yv * w + xv + k] = fundo(0x000000, self.cor)
        if self.festa is not None and t - self.festa < 4.5 and (t - self.festa > 1.5 or int((t - self.festa) * 4) % 2 == 0):
            gw = len(self.grito[0])
            gx, gy = (w - gw) // 2, h // 2 - 1
            for r, linha in enumerate(self.grito):
                for k, s in enumerate(linha):
                    if s != " ":
                        escrever(ch, co, w, h, gx + k, gy + r, s, hsv(k / gw + t * 0.8, 0.75, 1.0))
        if self.cantos:
            txt = f"cantos acertados: {self.cantos}"
            escrever(ch, co, w, h, w - len(txt) - 2, h - 1, txt, 0x6A6A6A)

    def festejar(self, t):
        self.festa = t
        self.cantos += 1
        cx = 0 if self.x < self.maxx / 2 else self.w - 1
        cy = 0 if self.y < self.maxy / 2 else self.h - 1
        base = math.atan2(self.h / 2 - cy, (self.w / 2 - cx) / ASPECTO)
        for _ in range(180):
            a = base + random.uniform(-0.9, 0.9)
            sp = random.uniform(15, 45)
            self.confete.append([float(cx), float(cy), math.cos(a) * sp * ASPECTO * 0.5, math.sin(a) * sp * 0.5,
                                 random.choice("*+•·✦x"), hsv(random.random(), 0.7, 1.0), t, random.uniform(2.5, 4)])


class Labirinto(Cena):
    """Andando por um labirinto 3D (raycasting, estilo Wolfenstein)."""
    duracao = (30, 45)
    DIRS = [(1, 0), (0, 1), (-1, 0), (0, -1)]
    ANG = [0.0, math.pi / 2, math.pi, -math.pi / 2]

    def iniciar(self):
        self.tema = random.choice(("arame", "tijolo", "neon"))
        n = 21
        g = [[1] * n for _ in range(n)]
        pilha = [(1, 1)]
        g[1][1] = 0
        while pilha:
            x, y = pilha[-1]
            viz = [(dx, dy) for dx, dy in ((2, 0), (-2, 0), (0, 2), (0, -2))
                   if 0 < x + dx < n - 1 and 0 < y + dy < n - 1 and g[y + dy][x + dx]]
            if viz:
                dx, dy = random.choice(viz)
                g[y + dy // 2][x + dx // 2] = 0
                g[y + dy][x + dx] = 0
                pilha.append((x + dx, y + dy))
            else:
                pilha.pop()
        for _ in range(14):
            x, y = random.randrange(1, n - 1), random.randrange(1, n - 1)
            if g[y][x] and ((not g[y][x - 1] and not g[y][x + 1]) or (not g[y - 1][x] and not g[y + 1][x])):
                g[y][x] = 0
        self.g = g
        self.cel = (1, 1)
        self.d = 0 if not g[1][2] else 1
        self.pos = [1.5, 1.5]
        self.ang = self.ANG[self.d]
        self.bob = 0.0
        self.t = 0.0
        self.K = self.w / 2.64
        self.gen = self.andar()

    def andar(self):
        while True:
            cx, cy = self.cel
            for nd in ((self.d + 1) % 4, self.d, (self.d + 3) % 4, (self.d + 2) % 4):
                dx, dy = self.DIRS[nd]
                if not self.g[cy + dy][cx + dx]:
                    break
            if nd != self.d:
                a0 = self.ang
                diff = (self.ANG[nd] - a0 + math.pi) % (2 * math.pi) - math.pi
                ini = self.t
                while self.t - ini < 0.45:
                    self.ang = a0 + diff * suave((self.t - ini) / 0.45)
                    yield
                self.ang = a0 + diff
                self.d = nd
            dx, dy = self.DIRS[self.d]
            x0, y0 = self.pos
            ini = self.t
            while self.t - ini < 0.42:
                p = (self.t - ini) / 0.42
                self.pos = [x0 + dx * p, y0 + dy * p]
                self.bob = math.sin(p * math.pi) * 0.6
                yield
            self.bob = 0.0
            self.cel = (cx + dx, cy + dy)
            self.pos = [cx + dx + 0.5, cy + dy + 0.5]

    def draw(self, t, dt, ch, co):
        self.t = t
        next(self.gen)
        w, h, K, g, tema = self.w, self.h, self.K, self.g, self.tema
        px, py = self.pos
        dx_, dy_ = math.cos(self.ang), math.sin(self.ang)
        plx, ply = -dy_ * 0.66, dx_ * 0.66
        cy = h / 2 + self.bob
        floor = math.floor
        if tema == "arame":
            aresta, piso, teto = 0x39FF6A, 0x1F9F45, 0x145F2E
        elif tema == "neon":
            aresta, piso, teto = 0x00F0FF, 0xFF2BD6, 0x5A1A7A
        else:
            aresta, piso, teto = 0xB5533C, 0x6B5A4A, 0
        for x in range(w):
            cam = 2 * x / w - 1
            rx, ry = dx_ + plx * cam, dy_ + ply * cam
            mx, my = int(px), int(py)
            ddx = abs(1 / rx) if rx else 1e30
            ddy = abs(1 / ry) if ry else 1e30
            if rx < 0:
                sx, sdx = -1, (px - mx) * ddx
            else:
                sx, sdx = 1, (mx + 1 - px) * ddx
            if ry < 0:
                sy, sdy = -1, (py - my) * ddy
            else:
                sy, sdy = 1, (my + 1 - py) * ddy
            while True:
                if sdx < sdy:
                    sdx += ddx
                    mx += sx
                    lado = 0
                else:
                    sdy += ddy
                    my += sy
                    lado = 1
                if g[my][mx]:
                    break
            dist = max(0.05, (sdx - ddx) if lado == 0 else (sdy - ddy))
            wx = (py + dist * ry) if lado == 0 else (px + dist * rx)
            wx -= floor(wx)
            alt = K / dist
            topo, base = cy - alt / 2, cy + alt / 2
            yt, yb = int(topo), int(base)
            v = clamp(1.6 / (dist + 0.6)) * (0.7 if lado else 1.0)
            borda = wx < 0.035 or wx > 0.965
            for y in range(h):
                i = y * w + x
                if y < yt or y > yb:
                    if tema == "tijolo":
                        if y > yb:
                            f = clamp((y - cy) / (h / 2))
                            ch[i] = ".:-="[min(3, int(f * 4))]
                            co[i] = escala(piso, 0.25 + 0.55 * f)
                        else:
                            ch[i] = " "
                        continue
                    dd = K / (2 * (y + 0.5 - cy)) if y > yb else K / (2 * (cy - y - 0.5))
                    if dd <= 0 or dd > 14:
                        ch[i] = " "
                        continue
                    fx, fy = px + dd * rx, py + dd * ry
                    fx -= floor(fx)
                    fy -= floor(fy)
                    lx, ly = fx < 0.07 or fx > 0.93, fy < 0.07 or fy > 0.93
                    if lx or ly:
                        ch[i] = "+" if lx and ly else "·"
                        co[i] = escala(piso if y > yb else teto, clamp(1.3 / (dd + 0.3)))
                    else:
                        ch[i] = " "
                    continue
                if tema == "tijolo":
                    c = escala(aresta, v)
                    s = "░▒▓█"[min(3, int(v * 4))]
                    if alt > 10:
                        ty = (y - topo) / alt * 4
                        off = 0.5 if int(ty) % 2 else 0.0
                        if ty - floor(ty) < 0.14:
                            s, c = "─", escala(0x3A2A25, v * 1.4)
                        elif (wx * 2 + off) % 1 < 0.07:
                            s, c = "│", escala(0x3A2A25, v * 1.4)
                    ch[i], co[i] = s, c
                elif y == yt or y == yb:
                    ch[i], co[i] = "─", escala(aresta, v)
                elif borda:
                    ch[i], co[i] = "│", escala(aresta, v)
                elif tema == "neon":
                    ch[i], co[i] = "█", escala(0x0B0B2B, 0.5 + v)
                else:
                    ch[i] = " "


